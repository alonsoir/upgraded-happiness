# ======================
# MODELS MANAGEMENT
# ======================
# Ignorar todos los modelos salvo los de production/ y tricapa/
models/*.joblib
!models/production/*.joblib
!models/tricapa/*.joblib

# Ignorar archivos pesados experimentales
models/archive/
models/experimental/

# No ignorar GeoLite2
!GeoLite2-City.mmdb

# Ignorar explicadores SHAP pesados
*shap_explainer.pkl

# Ignorar configuraciones JSON enormes
config/json/project_analysis.json

# ========================
# Ignorar joblib y similares por defecto
*.joblib
*.pkl
*.json

# ========================
# Pero NO ignorar los joblib/json que están en production y tricapa
!models/production/*.joblib
!models/production/*.json
!models/production/tricapa/*.joblib
!models/production/tricapa/*.json

# ========================
# Ignorar caché de seguridad de ggshield
.cache_ggshield

