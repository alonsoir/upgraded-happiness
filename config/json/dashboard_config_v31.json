    "update_interval": 2,
    "retention_hours": 48,
    "export_prometheus": false,

    "v31_metrics": {
      "track_protobuf_v31_volume": true,
      "track_fleet_operations": true,
      "track_nuclear_broadcasts": true,
      "track_ml_detector_v31_latency": true
