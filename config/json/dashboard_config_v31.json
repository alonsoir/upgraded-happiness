  "web_interface": {
    "enabled": true,
    "static_files_path": "templates",
    "templates_path": "templates",
    "cache_control": "no-cache",
    "host": "0.0.0.0",
    "port": 8080,
    "debug": false,

    "_comment_v31_ui": "🎨 V3.1 UI FEATURES",
    "v31_features": {
      "show_dual_coordinates": true,
      "show_fleet_status": true,
      "enable_nuclear_broadcast": true,
      "show_ml_analysis_v31": true,
