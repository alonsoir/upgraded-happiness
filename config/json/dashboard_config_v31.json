{
  "node_id": "dashboard_main_v31_001",
  "component": {
    "name": "dashboard_scada_v31",
    "version": "3.1.0-CRYPTO-FLEET",
    "mode": "distributed_monitoring_crypto",
    "description": "Dashboard SCADA V3.1 con crypto automático + fleet management cifrada"
  },

  "_comment_crypto": "🔐 SECCIÓN CRYPTO AÑADIDA - AES-256-GCM + LZ4 automático",

  "network": {
    "ml_events_input": {
      "enabled": true,
      "address": "localhost",
      "port": 5580,
      "mode": "connect",
      "socket_type": "SUB",
      "high_water_mark": 1000,
      "description": "Receives encrypted events from ML Detector V3.1.2 tricapa",
      "_comment": "📥 ML_DETECTOR → DASHBOARD: Puerto 5580 SUB (cifrado automático)"
    },
    "scheduler_communication": {
      "enabled": false,
      "address": "localhost",
      "port": 5585,
      "mode": "connect",
      "socket_type": "REQ",
      "description": "Optional communication with scheduler_firewall",
      "_comment": "📞 DASHBOARD ↔ SCHEDULER: Comunicación opcional"
    }
  },

  "firewall_fleet": {
    "enabled": true,
    "description": "Fleet management para múltiples agentes firewall V3.1",
    "_comment": "🔥 FLEET CIFRADA - Comunicación segura con agentes",
    "agents": [
      {
        "node_id": "simple_firewall_agent_001",
        "network_endpoints": {
          "dashboard_commands": {
            "address": "localhost",
            "port": 5590,
            "mode": "connect",
            "socket_type": "PUSH",
            "high_water_mark": 500,
            "description": "Commands to firewall agent (encrypted)"
          },
          "dashboard_responses": {
            "address": "localhost",
            "port": 5591,
            "mode": "bind",
            "socket_type": "PULL",
            "high_water_mark": 500,
            "description": "Responses from firewall agent (encrypted)"
          }
        },
        "capabilities": {
          "allowed_actions": ["MONITOR", "LIST_RULES", "RATE_LIMIT_IP"],
          "blocked_actions": ["FLUSH_RULES", "BACKUP_RULES"],
          "max_concurrent_rules": 10,
          "default_rule_duration": 300
        },
        "security_profile": {
          "safety_mode": "ULTRA_SECURE_V31",
          "force_dry_run": true,
          "require_confirmation": true
        },
        "location": "primary_node",
        "version": "3.1.0",
        "status": "active"
      }
    ],
    "fleet_management": {
      "auto_discovery": false,
      "health_check_interval": 30,
      "command_timeout": 10,
      "max_retry_attempts": 3,
      "load_balancing": "round_robin"
    }
  },

  "zmq": {
    "context_io_threads": 2,
    "_comment_crypto": "🔄 Increased threads para crypto processing",
    "max_sockets": 32,
    "tcp_keepalive": true,
    "tcp_keepalive_idle": 300,
    "immediate": false,
    "linger_ms": 1000,
    "recv_timeout_ms": 1000,
    "send_timeout_ms": 1000,
    "zmq_optimizations": {
      "sndbuf": 131072,
      "rcvbuf": 131072,
      "recovery_ivl": 10000
    }
  },

  "web_server": {
    "host": "0.0.0.0",
    "port": 8080,
    "debug": false,
    "threaded": true,
    "cors": {
      "enabled": true,
      "origins": ["*"],
      "methods": ["GET", "POST", "OPTIONS"],
      "headers": ["Content-Type", "Authorization"]
    },
    "security": {
      "rate_limiting": {
        "enabled": true,
        "requests_per_minute": 100,
        "burst": 20
      },
      "csrf_protection": false,
      "secure_headers": true
    }
  },

  "monitoring": {
    "stats_interval_seconds": 30,
    "detailed_metrics": true,
    "health_check": {
      "enabled": true,
      "check_interval_seconds": 60,
      "endpoints": [
        "/api/metrics",
        "/api/health"
      ]
    },
    "alerts": {
      "max_error_rate_percent": 5.0,
      "max_response_time_ms": 1000.0,
      "max_memory_usage_mb": 512,
      "min_events_per_minute": 0,
      "max_queue_usage_percent": 80.0
    },
    "crypto_monitoring": {
      "track_encryption_metrics": true,
      "track_compression_ratio": true,
      "track_key_rotations": true,
      "alert_on_crypto_failures": true
    }
  },

  "data_processing": {
    "max_events_in_memory": 1000,
    "event_retention_hours": 2,
    "auto_cleanup_enabled": true,
    "batch_processing": {
      "enabled": false,
      "batch_size": 50,
      "flush_interval_seconds": 5
    },
    "event_filtering": {
      "enabled": true,
      "min_risk_score": 0.0,
      "max_events_per_minute": 1000,
      "duplicate_detection": true
    }
  },

  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - [dashboard_v31] [crypto:{crypto_status}] - %(message)s",
    "handlers": {
      "console": {
        "enabled": true,
        "level": "INFO",
        "colored": true
      },
      "file": {
        "enabled": true,
        "path": "logs/dashboard_v31.log",
        "level": "INFO",
        "max_size": "50MB",
        "backup_count": 5,
        "rotation": "size"
      },
      "crypto_log": {
        "enabled": true,
        "path": "logs/dashboard_crypto_v31.log",
        "level": "DEBUG",
        "log_encryption_events": true,
        "log_key_rotations": true,
        "log_compression_stats": true
      }
    }
  },

  "security": {
    "input_validation": {
      "enabled": true,
      "max_request_size": 10240,
      "validate_json_schema": true,
      "sanitize_inputs": true
    },
    "api_security": {
      "require_authentication": false,
      "rate_limiting": true,
      "request_logging": true,
      "error_masking": true
    },
    "crypto_security": {
      "enforce_encryption": true,
      "reject_unencrypted_ml_events": false,
      "require_fleet_encryption": true,
      "crypto_failure_action": "log_and_continue"
    }
  },

  "distributed": {
    "cluster_name": "upgraded-happiness-cluster-v31-crypto",
    "component_role": "dashboard_monitoring_crypto_v31",
    "enable_container_detection": true,
    "enable_system_info_collection": true,
    "pipeline_tracking": {
      "enabled": true,
      "track_latency": true,
      "track_component_path": true,
      "max_pipeline_hops": 6,
      "track_crypto_latency": true
    }
  },

  "debug": {
    "enabled": false,
    "log_all_events": false,
    "log_zmq_messages": false,
    "simulate_events": false,
    "crypto_debug": {
      "log_encryption_details": false,
      "log_key_operations": false,
      "log_compression_details": false,
      "performance_profiling": false
    }
  },

  "_comment_crypto": "🔐 CRYPTO CONFIGURATION - SAME PATTERN AS SCHEDULER AND AGENT",
  "crypto": {
    "enabled": true,
    "role": "receiver_sender",
    "config_file": "config/crypto/crypto_config_v31.json",
    "channels": {
      "ml_events_input": {
        "decrypt": true,
        "description": "Descifrar eventos ML automáticamente (CRÍTICO para seguridad)"
      },
      "firewall_agents_fleet": {
        "commands_encrypt": true,
        "responses_decrypt": true,
        "description": "Fleet cifrada completa - comandos y respuestas (MÁXIMA SEGURIDAD)"
      },
      "scheduler_communication": {
        "encrypt": true,
        "decrypt": true,
        "description": "Comunicación opcional con scheduler (si habilitada)"
      }
    },
    "component_crypto_id": "dashboard_main_v31_001",
    "crypto_performance": {
      "enable_compression": true,
      "compression_threshold": 512,
      "encryption_buffer_size": 65536,
      "batch_crypto_operations": false
    }
  },

  "_crypto_architecture": {
    "ml_detector_flow": {
      "in": "ml_detector:5580(PUB) → dashboard:5580(SUB)",
      "encryption": "🔓 DECRYPT automático - eventos ML cifrados",
      "compression": "🗜️ LZ4 decompression automática",
      "pattern": "PUB/SUB con descifrado transparente"
    },
    "fleet_management_flow": {
      "out": "dashboard:5590(PUSH) → agents:5590(PULL)",
      "in": "agents:5591(PUSH) → dashboard:5591(PULL)",
      "encryption": "🔒🔓 ENCRYPT commands + DECRYPT responses",
      "compression": "🗜️ LZ4 compression/decompression automática",
      "pattern": "Fleet cifrada bidireccional"
    },
    "crypto_benefits": {
      "transparent_encryption": "Desarrollador no ve algoritmos crypto",
      "automatic_compression": "LZ4 reduce ancho de banda automáticamente",
      "shared_pipeline_key": "UPGRADED_HAPPINESS_PIPELINE_KEY para todo el cluster",
      "red_team_safe": "Imposible extraer claves desde frontend JavaScript",
      "zero_knowledge_crypto": "Backend maneja toda la criptografía"
    }
  },

  "_performance_optimization": {
    "crypto_threading": "Threads separados para crypto operations",
    "compression_adaptive": "LZ4 solo para mensajes > 512 bytes",
    "key_rotation": "15 minutos (configurable)",
    "memory_encryption": "Claves solo en memoria - nunca en disco",
    "fleet_parallelization": "Comandos a múltiples agentes en paralelo"
  },

  "_config_metadata": {
    "config_version": "3.1.0-CRYPTO-ENABLED",
    "created_for": "Dashboard Backend con crypto automático",
    "crypto_pattern": "SAME_AS_SCHEDULER_AND_AGENT",
    "security_level": "MAXIMUM - AES-256-GCM + LZ4",
    "fleet_communication": "ENCRYPTED_BIDIRECTIONAL",
    "performance_target": "TRANSPARENT_CRYPTO_WITH_COMPRESSION"
  }
}