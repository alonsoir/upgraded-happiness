    "agent_communication": {
      "pattern": "PUB_SUB_ASYNC",
      "dual_channel_support": true,
      "scheduler_coordination": false,
      "_comment": "Dashboard usa PUB/SUB, scheduler usa PUSH/PULL"
    },

    "command_execution": {
      "default_timeout": 30,
      "retry_attempts": 0,
      "auto_reload_rules": true,
      "test_commands_enabled": true,
      "safety_mode": "ULTRA_SECURE_V31"
