    "version": "3.1.0",
    "import_strategy": "TODO_O_NADA",
    "required_modules": [
      "network_security_clean_v31_pb2",
      "firewall_commands_v31_pb2"
    ],
    "compatibility_mode": false,
    "native_v31_fields": true
  },

  "network": {
    "_comment_ml_detector": "🔄 CRÍTICO: SUB al ML_detector V3.1 puerto 5580",
    "ml_events_input": {
      "address": "localhost",
      "port": 5580,
      "mode": "connect",
      "socket_type": "SUB",
      "topic_filter": "",
      "high_water_mark": 2000,
      "expected_publishers": 1,
      "description": "SUB a ML_detector V3.1 NetworkSecurityEvent en puerto 5580",
      "_change_log": "PULL:5570 → SUB:5580 para V3.1 compatibility"
    },

    "_comment_fleet": "🔥 FLEET MANAGEMENT: Múltiples firewall agents desde JSON",
    "firewall_agents_fleet": {
      "fleet_config_source": "firewall_rules.json",
      "auto_discovery": true,
      "load_from_agents_fleet_section": true,
      "nuclear_broadcast_enabled": true,
      "coordination_pattern": "PUB_SUB_ASYNC"
    },

    "_comment_admin": "🌐 Admin interface sin cambios",
    "admin_interface": {
      "address": "0.0.0.0",
      "port": 8080,
      "websocket_enabled": false,
      "_future": "WebSocket bridge para V3.2"
    }
  },

  "zmq": {
    "_comment_v31": "⚙️ ZMQ optimizado para V3.1 + fleet management",
    "context_io_threads": 2,
    "max_sockets": 64,
    "tcp_keepalive": true,
    "tcp_keepalive_idle": 300,
    "immediate": true,

    "_comment_buffers": "📦 Buffers aumentados para NetworkSecurityEvent (más grande que V3.0)",
    "linger_ms": 0,
    "recv_timeout_ms": 1000,
    "send_timeout_ms": 1000,
    "max_message_size": 100000,
    "recv_buffer_size": 131072,
    "send_buffer_size": 131072,

    "_ml_detector_sub": {
      "rcvhwm": 2000,
      "subscribe_all_topics": true,
      "conflate": false,
      "_comment": "SUB settings específicos para ML_detector V3.1"
    },

    "_fleet_management": {
      "max_agents": 10,
      "agent_timeout_ms": 5000,
      "broadcast_hwm": 1000,
      "_comment": "Settings para fleet de firewall agents"
    }
  },

  "processing": {
    "_comment_v31": "🧵 Threads optimizados para V3.1 + fleet",
    "threads": {
      "ml_events_consumers": 1,
      "firewall_fleet_managers": 1,
      "firewall_response_aggregators": 1,
      "_comment": "Reducido a 1 thread cada uno para evitar race conditions V3.1"
    },

    "internal_queues": {
      "ml_events_queue_size": 1000,
      "firewall_commands_queue_size": 500,
      "firewall_responses_queue_size": 500,
      "fleet_broadcast_queue_size": 200
    },

    "_v31_processing": {
      "parse_network_security_event": true,
      "extract_83_ml_features": true,
      "process_dual_geolocation": true,
      "track_tricapa_analysis": true,
      "enable_pipeline_tracking": true
    },

    "queue_management": {
      "enabled": true,
      "overflow_strategy": "drop_oldest",
      "max_wait_ms": 100,
      "emergency_drop_threshold": 80.0
    },

    "_comment_data": "📊 Sin límites - todos los eventos se procesan",
    "event_buffer_size": "unlimited",
    "max_events_per_update": "unlimited",
    "event_retention_hours": 24,
    "enable_event_filtering": false,
    "risk_score_threshold": 0.0
  },

  "_comment_fleet_integration": "🔥 INTEGRACIÓN COMPLETA CON FLEET DE FIREWALL AGENTS",
  "firewall_integration": {
    "enabled": true,
    "version": "3.1.0",
    "fleet_config_source": "firewall_rules.json",

    "fleet_management": {
      "auto_discovery": true,
      "nuclear_broadcast_enabled": true,
      "async_communication": true,
      "fire_and_forget": true,
      "fleet_health_monitoring": true
