{
  "component": {
    "name": "lightweight_ml_detector_tricapa_v31",
    "version": "3.1.0",
    "mode": "tricapa_distributed_v31"
  },
  "node_id": "ml_detector_tricapa_v31_001",
  "version": "3.1.0",
  "component_type": "ml_detector_tricapa_v31",

  "network": {
    "input_socket": {
      "address": "localhost",
      "port": 5560,
      "mode": "connect",
      "socket_type": "PULL",
      "description": "Recibe eventos enriquecidos v3.1 del geoip_enricher con análisis geográfico completo"
    },
    "output_socket": {
      "address": "localhost",
      "port": 5580,
      "mode": "bind",
      "socket_type": "PUSH",
      "description": "Envía eventos v3.1 con análisis tricapa completo al dashboard"
    }
  },

  "zmq": {
    "input_port": 5560,
    "output_port": 5580,

    "_comment_hwm": "HWM realistas con consumidor activo",
    "rcvhwm": 1000,
    "sndhwm": 1000,

    "_comment_timeouts": "Timeouts normales con receptor funcionando",
    "recv_timeout_ms": 1000,
    "send_timeout_ms": 500,

    "_comment_linger": "Cierre inmediato como dashboard",
    "linger_ms": 0,

    "_comment_buffers": "Buffers aumentados para tricapa",
    "recv_buffer_size": 131072,
    "send_buffer_size": 131072,

    "_comment_message_size": "Límite aumentado para análisis tricapa completo",
    "max_message_size": 50000,

    "vertical_scaling_optimizations": {
      "io_threads": 2,
      "max_sockets": 64,
      "tcp_keepalive": true,
      "tcp_keepalive_idle": 300,
      "immediate": true,
      "conflate": false
    }
  },

  "backpressure": {
    "enabled": true,
    "_comment_retries": "Más permisivo para procesamiento tricapa complejo",
    "max_retries": 3,
    "retry_delays_ms": [5, 15, 30],
    "drop_threshold_percent": 10.0,
    "activation_threshold": 30,
    "queue_full_strategy": "drop_oldest",

    "_comment_tricapa": "Configuración específica para tricapa",
    "emergency_drop_enabled": true,
    "emergency_drop_threshold_percent": 75.0,
    "force_flush_interval_ms": 200
  },

  "processing": {
    "_comment_threads": "Configuración SEGURA - Pool de workers en lugar de múltiples threads ZMQ",
    "threads": 4,
    "send_threads": 1,
    "_comment_workers": "Workers internos para procesamiento ML paralelo",
    "ml_worker_processes": 6,
    "max_workers": 8,

    "_comment_queues": "Colas adaptadas a la nueva realidad tricapa",
    "internal_queue_size": 1000,
    "protobuf_queue_size": 800,
    "queue_timeout_seconds": 2.0,

    "_comment_performance": "Modo tricapa con expectativas realistas",
    "performance_mode": "tricapa_heavy_v31",
    "enable_heuristics": true,
    "enable_alerts": true,
    "max_processing_time": 10.0,

    "vertical_scaling": {
      "optimized_for_tricapa": true,
      "memory_buffer_multiplier": 2.0,
      "cpu_intensive_operations": true,
      "leave_cores_for_system": 1,
      "processing_batch_optimization": false
    },

    "queue_overflow_handling": {
      "strategy": "drop_oldest",
      "max_queue_wait_ms": 50,
      "emergency_drop_threshold_percent": 75.0,
      "log_drops": true
    },

    "batch_processing": {
      "enabled": false,
      "batch_size": 1,
      "max_wait_ms": 100
    },

    "_comment_message_validation": "Validación específica para protobuf v3.1",
    "message_validation": {
      "enabled": true,
      "max_protobuf_size": 45000,
      "validate_before_processing": true,
      "drop_oversized_messages": true,
      "log_validation_errors": true,
      "validate_v31_schema": true,
      "require_network_features": true
    }
  },

  "ml": {
    "enabled": true,
    "_comment_thresholds": "🚨 UMBRALES CRÍTICOS - TODOS configurables aquí",
    "thresholds": {
      "level1_attack_threshold": 0.65,
      "level2_ddos_threshold": 0.70,
      "level2_ransomware_threshold": 0.75,
      "level3_anomaly_threshold": 0.80,
      "_comment_experimental": "Umbrales más altos para reducir falsos positivos en producción"
    },

    "_comment_degraded_mode": "Configuración para modo degradado",
    "degraded_mode": {
      "min_models_required": 3,
      "continue_with_partial_models": true,
      "log_degraded_operations": true,
      "fallback_to_heuristics": true
    },

    "models": {
      "_comment_level1": "🥇 NIVEL 1: Detector general (23 features + scaler)",
      "level1_attack_detector": {
        "enabled": true,
        "model_file": "rf_production_sniffer_compatible.joblib",
        "scaler_file": "rf_production_sniffer_compatible_scaler.joblib",
        "features_count": 23,
        "requires_scaling": true,
        "model_location": "production"
      },

      "_comment_level2": "🥈 NIVEL 2: Arsenal especializado (82 features, sin scaler)",
      "ddos_rf": {
        "enabled": true,
        "model_file": "ddos_random_forest.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ddos"
      },
      "ddos_lgb": {
        "enabled": true,
        "model_file": "ddos_lightgbm.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ddos"
      },
      "ransomware_rf": {
        "enabled": true,
        "model_file": "ransomware_random_forest.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ransomware"
      },
      "ransomware_lgb": {
        "enabled": true,
        "model_file": "ransomware_lightgbm.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ransomware"
      },

      "_comment_level3": "🥉 NIVEL 3: Detectores de normalidad (4 features, sin scaler)",
      "internal_detector": {
        "enabled": true,
        "model_file": "internal_normal_detector.joblib",
        "features_count": 4,
        "requires_scaling": false,
        "model_location": "tricapa_or_production",
        "traffic_type": "internal"
      },
      "web_detector": {
        "enabled": true,
        "model_file": "web_normal_detector.joblib",
        "features_count": 4,
        "requires_scaling": false,
        "model_location": "tricapa_or_production",
        "traffic_type": "web"
      }
    },

    "feature_engineering": {
      "_comment_v31": "Features específicas para protobuf v3.1",
      "use_protobuf_v31_fields": true,
      "extract_82_features_from_network_features": true,
      "apply_feature_mapping_82_to_23": true,
      "apply_feature_mapping_82_to_4": true,

      "_comment_mappings": "Configuración de mapeos de features",
      "feature_mappings": {
        "82_to_23_enabled": true,
        "82_to_4_enabled": true,
        "validate_feature_counts": true,
        "pad_missing_features": true,
        "log_mapping_errors": true
      },

      "_comment_extraction": "Configuración de extracción",
      "feature_extraction": {
        "ignore_repeated_double_fields": true,
        "use_network_features_struct": true,
        "validate_protobuf_fields": true,
        "handle_missing_fields_gracefully": true
      }
    }
  },

  "tricapa": {
    "_comment_system": "🎯 CONFIGURACIÓN DEL SISTEMA TRICAPA COMPLETO",
    "enabled": true,
    "version": "3.1.0",

    "architecture": {
      "level1_name": "General Attack Detection",
      "level1_description": "RF production model (23 features) - Initial attack detection",
      "level2_name": "Specialized Threat Classification",
      "level2_description": "Arsenal of specialized models (82 features) - DDOS vs Ransomware",
      "level3_name": "Normality Validation",
      "level3_description": "Traffic-specific normalcy detection (4 features) - Internal vs Web"
    },

    "ensemble": {
      "_comment_ensemble": "Configuración del ensemble tricapa",
      "enabled": true,
      "confidence_threshold": 0.60,
      "use_weighted_voting": false,
      "level2_combination_strategy": "max_score",
      "level3_activation_strategy": "traffic_type_based",

      "_comment_weights": "Pesos por nivel (para futuras implementaciones)",
      "level_weights": {
        "level1": 0.4,
        "level2": 0.4,
        "level3": 0.2
      }
    },

    "model_paths": {
      "_comment_paths": "Configuración específica de rutas de modelos",
      "base_models_dir": "models",
      "production_subdir": "production",
      "tricapa_subdir": "production/tricapa",
      "auto_discover_models": true,
      "fallback_model_locations": ["production", "tricapa"],
      "validate_model_files_on_startup": true
    },

    "performance": {
      "_comment_performance": "Optimizaciones específicas para tricapa",
      "parallel_level2_predictions": false,
      "cache_feature_extractions": true,
      "cache_size": 1000,
      "enable_model_warmup": true,
      "warmup_iterations": 5,
      "log_prediction_times": false
    },

    "failure_handling": {
      "_comment_failures": "Manejo de fallos en sistema tricapa",
      "continue_on_model_failure": true,
      "min_models_for_operation": 2,
      "level1_failure_strategy": "abort_analysis",
      "level2_failure_strategy": "continue_with_available",
      "level3_failure_strategy": "skip_level",
      "log_model_failures": true,
      "escalate_critical_failures": true
    }
  },

  "advanced_logging": {
    "_comment_dual_logging": "🔥 SISTEMA DE LOGGING DUAL AVANZADO",
    "enabled": true,
    "version": "3.1.0",

    "_comment_rag": "Configuración de logs para RAG",
    "rag_logging": {
      "enabled": true,
      "rag_json_base_dir": "logs/rag/json",
      "file_format": "events_{HHMMSS}.json",
      "directory_structure": "{year}/{month:02d}/{day:02d}",
      "max_events_per_file": 100,
      "compression_enabled": false,
      "include_embeddings_keywords": true,
      "include_threat_summaries": true,
      "include_ml_summaries": true,
      "include_tricapa_analysis": true
    },

    "_comment_protobuf": "Configuración de logs protobuf para análisis profundo",
    "protobuf_logging": {
      "enabled": true,
      "protobuf_base_dir": "logs/proto",
      "file_format": "events_{HHMMSS}.proto",
      "directory_structure": "{year}/{month:02d}/{day:02d}",
      "append_mode": true,
      "compression_enabled": false,
      "max_file_size_mb": 100,
      "rotate_files": true,
      "preserve_original_protobuf": true
    },

    "_comment_indexing": "Configuración para indexación eficiente",
    "indexing": {
      "enabled": true,
      "create_index_files": true,
      "index_format": "json",
      "index_fields": ["timestamp", "threat_classification", "confidence", "models_used"],
      "update_index_frequency": "hourly",
      "compress_old_indexes": true
    },

    "_comment_retention": "Configuración de retención",
    "retention": {
      "enabled": true,
      "rag_logs_retention_days": 30,
      "protobuf_logs_retention_days": 7,
      "index_retention_days": 90,
      "cleanup_frequency": "daily",
      "compress_before_deletion": true
    }
  },

  "logging": {
    "_comment_standard": "Logging estándar (consola + archivo)",
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - [tricapa_v31:{node_id}] [pid:{pid}] - %(message)s",
    "file": "logs/tricapa_ml_detector_v31.log",
    "max_file_size_mb": 100,
    "backup_count": 5,

    "performance_logging": {
      "enabled": true,
      "log_slow_requests": true,
      "slow_request_threshold_ms": 50,
      "log_model_prediction_times": true,
      "log_feature_extraction_times": false
    },

    "console_logging": {
      "enabled": true,
      "level": "INFO",
      "format_console": "%(asctime)s [TRICAPA_v31] %(levelname)s: %(message)s"
    },

    "file_logging": {
      "enabled": true,
      "level": "INFO",
      "rotation_enabled": true,
      "rotation_when": "midnight",
      "rotation_backup_count": 7
    }
  },

  "monitoring": {
    "_comment_monitoring": "Monitoreo específico para tricapa",
    "stats_interval_seconds": 30,
    "detailed_metrics": true,
    "track_tricapa_performance": true,

    "component_health_check": {
      "enabled": true,
      "check_interval_seconds": 60,
      "memory_threshold_mb": 512,
      "cpu_threshold_percent": 60.0,
      "model_response_time_threshold_ms": 100.0
    },

    "tricapa_specific_alerts": {
      "_comment_tricapa_alerts": "Alertas específicas del sistema tricapa",
      "max_level1_failure_rate_percent": 5.0,
      "max_level2_ensemble_disagreement_percent": 30.0,
      "max_level3_skip_rate_percent": 20.0,
      "min_overall_model_availability_percent": 70.0,
      "max_degraded_mode_duration_minutes": 30,
      "max_feature_extraction_errors_per_hour": 10
    },

    "alerts": {
      "_comment_standard_alerts": "Alertas estándar adaptadas para tricapa",
      "max_queue_usage_percent": 60.0,
      "max_ml_failure_rate_percent": 15.0,
      "max_processing_latency_ms": 100.0,
      "max_backpressure_activations": 10,
      "max_drop_rate_percent": 5.0,
      "min_model_accuracy_percent": 50.0,
      "max_buffer_full_errors": 5,
      "max_message_size_violations": 8,
      "max_send_timeouts": 15,
      "_comment_v31": "Alertas específicas para protobuf v3.1",
      "min_v31_network_features_rate": 90.0,
      "max_v31_feature_extraction_errors": 10
    },

    "metrics_export": {
      "enabled": false,
      "prometheus_port": 9092,
      "export_interval_seconds": 60,
      "include_tricapa_metrics": true,
      "include_model_performance_metrics": true
    }
  },

  "distributed": {
    "cluster_name": "upgraded-happiness-cluster-v31",
    "component_role": "ml_detector_tricapa_v31",
    "enable_container_detection": true,
    "enable_system_info_collection": true,

    "pipeline_tracking": {
      "enabled": true,
      "track_latency": true,
      "track_component_path": true,
      "max_pipeline_hops": 6,
      "track_tricapa_stages": true,
      "include_model_metadata": true,
      "track_v31_enhancements": true
    },

    "load_balancing": {
      "strategy": "weighted_round_robin",
      "health_check_enabled": true,
      "failover_timeout_ms": 5000,
      "consider_tricapa_load": true
    },

    "scaling": {
      "_comment_scaling": "Auto-scaling para tricapa (futuro)",
      "auto_scale_enabled": false,
      "min_instances": 1,
      "max_instances": 3,
      "scale_up_threshold_percent": 85.0,
      "scale_down_threshold_percent": 20.0,
      "cooldown_period_seconds": 600,
      "scale_based_on_model_load": true
    }
  },

  "security": {
    "input_validation": {
      "enabled": true,
      "max_event_size_bytes": 50000,
      "validate_protobuf_schema": true,
      "validate_v31_schema_version": true,
      "sanitize_ml_scores": true,
      "reject_malformed_events": true,
      "validate_network_features_completeness": true,
      "require_minimum_features": true,
      "min_required_features": 20
    },

    "rate_limiting": {
      "enabled": true,
      "max_events_per_second": 200,
      "burst_capacity": 500,
      "penalty_duration_seconds": 60,
      "consider_processing_complexity": true
    },

    "model_security": {
      "_comment_model_security": "Seguridad específica de modelos",
      "validate_model_integrity": true,
      "model_checksum_validation": false,
      "restrict_model_loading_paths": true,
      "allowed_model_extensions": [".joblib", ".pkl"],
      "log_model_access": true
    }
  },

  "debug": {
    "enabled": false,
    "sample_events": false,
    "sample_rate_percent": 1.0,
    "log_protobuf_details": false,
    "profile_performance": false,
    "log_ml_predictions": false,
    "log_feature_extraction": false,

    "_comment_tricapa_debug": "Debug específico para tricapa",
    "log_tricapa_stages": false,
    "log_feature_mappings": false,
    "log_model_loading": true,
    "log_ensemble_decisions": false,
    "validate_feature_counts": true,
    "log_degraded_mode_operations": true,

    "_comment_advanced_debug": "Debug avanzado",
    "log_zmq_errors": true,
    "log_backpressure_events": true,
    "log_message_sizes": false,
    "log_v31_network_features": false,
    "log_advanced_logging_operations": false,
    "validate_v31_compatibility": true,
    "performance_profiling": {
      "enabled": false,
      "profile_model_predictions": false,
      "profile_feature_extraction": false,
      "profile_protobuf_operations": false
    }
  },

  "_comment_v31_features": "=== NUEVAS CARACTERÍSTICAS v3.1 ===",
  "v31_enhancements": {
    "protobuf_v31_support": {
      "enabled": true,
      "use_network_features_struct": true,
      "validate_schema_version": true,
      "handle_backward_compatibility": false,
      "prefer_v31_fields": true
    },

    "tricapa_architecture": {
      "enabled": true,
      "full_arsenal_mode": true,
      "parallel_level2_processing": false,
      "dynamic_model_selection": false,
      "adaptive_thresholds": false
    },

    "advanced_logging_system": {
      "enabled": true,
      "dual_format_logging": true,
      "rag_optimized_format": true,
      "time_series_organization": true,
      "efficient_indexing": true
    },

    "intelligent_degradation": {
      "enabled": true,
      "continue_with_partial_models": true,
      "intelligent_fallbacks": true,
      "graceful_failure_handling": true,
      "recovery_mechanisms": true
    },

    "performance_optimizations": {
      "enabled": true,
      "feature_extraction_caching": true,
      "model_prediction_caching": false,
      "memory_efficient_operations": true,
      "optimized_protobuf_handling": true
    }
  },

  "_comment_compatibility": "=== COMPATIBILIDAD Y MIGRACIÓN ===",
  "compatibility": {
    "backward_compatible_with_v3": false,
    "forward_compatible_preparation": true,
    "migration_mode": false,
    "validate_legacy_fields": false,
    "log_compatibility_issues": true,
    "protobuf_version_enforcement": "strict_v31"
  },

  "_comment_validation": "=== VALIDACIÓN FINAL ===",
  "configuration_validation": {
    "validate_on_startup": true,
    "require_all_thresholds": true,
    "validate_model_paths": true,
    "validate_logging_paths": true,
    "strict_mode": true,
    "abort_on_critical_errors": true
  },

  "_config_metadata": {
    "config_version": "3.1.0",
    "created_for": "lightweight_ml_detector_tricapa_v31.py",
    "creation_date": "2025-08-10",
    "description": "Configuración completa para sistema tricapa v3.1 con logging dual y protobuf v3.1",
    "validated": true
  }
}