{
  "component": {
    "name": "lightweight_ml_detector_tricapa_v31",
    "version": "3.1.2-pubsub-optimized",
    "mode": "tricapa_json_controlled_pubsub"
  },
  "node_id": "ml_detector_tricapa_v31_001",
