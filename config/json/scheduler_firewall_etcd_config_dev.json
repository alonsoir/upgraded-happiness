    "firewall_responses_input": {
      "address": "localhost",
      "port": 5581,
      "mode": "bind",
      "socket_type": "PULL",
      "high_water_mark": 100,
      "_comment_fix": "🔧 HWM reducido de 300 a 100"
    }
  },
  "_port_flow_etcd": {
    "step_1": "ml_detector:5580(PUB+ENCRYPT) \u2192 scheduler:5580(SUB+DECRYPT)",
    "step_2": "scheduler:5582(PUSH+ENCRYPT) \u2192 firewall_agent:5582(PULL+DECRYPT)",
