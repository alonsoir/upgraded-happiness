# =============================================================================
# GeoIP Enricher V3.1 ETCD - Ultra-secure Lightweight Dockerfile
# Component: geoip_enricher_v31_etcd.py
# Security: Non-root, AppArmor ready, minimal surface, precise file copying
# Base: python:3.12-slim (compatible con pyzmq)
# =============================================================================

# Stage 1: Build dependencies
FROM python:3.12-slim@sha256:af4e85f1cac90dd3771e47292ea7c8a9830abfabbe4faa5c53f158854c2e819d AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Install build dependencies - minimal set
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Copy and install Python dependencies only
COPY infrastructure/docker/requirements-geoip.txt ./requirements.txt
RUN pip install --user --no-warn-script-location -r requirements.txt

# Stage 2: Runtime - Ultra minimal
FROM python:3.12-slim@sha256:af4e85f1cac90dd3771e47292ea7c8a9830abfabbe4faa5c53f158854c2e819d AS runtime

# Create unprivileged user with specific UID/GID for security
RUN groupadd -g 1001 geoip && \
    useradd -u 1001 -g 1001 -r -m -d /home/geoip geoip

# Set working directory
WORKDIR /app

# Install ONLY runtime dependencies - absolutely minimal
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Copy Python packages from builder
COPY --from=builder /root/.local /home/geoip/.local

# Copy ONLY the specific files we need - precise file copying
# Main application
COPY core/geoip_enricher_v31_etcd.py /app/

# Critical dependency - etcd crypto client (reused from dashboard)
COPY core/etcd_crypto_client_geoip_fixed.py /app/

# Protocols (protobuf compiled files) with correct structure
COPY protocols/__init__.py /app/protocols/
COPY protocols/v3_1/__init__.py /app/protocols/v3_1/
COPY protocols/v3_1/network_security_clean_v31_pb2.py /app/protocols/v3_1/
COPY protocols/v3_1/firewall_commands_v31_pb2.py /app/protocols/v3_1/

# Configuration files
COPY infrastructure/config/geoip_config_docker.json /app/config/json/

# GeoIP database directory (if needed - to be mounted or downloaded)
RUN mkdir -p /app/data/geoip

# Create minimal directory structure and set ownership
RUN mkdir -p /app/logs && \
    chown -R geoip:geoip /app /home/geoip

# Switch to unprivileged user
USER geoip

# Set PATH for user-installed packages
ENV PATH="/home/geoip/.local/bin:${PATH}"

# Security: No new privileges
USER 1001:1001

# Minimal health check - test GeoIP service readiness
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import psutil, sys; sys.exit(0 if psutil.virtual_memory().percent < 90 else 1)" || exit 1

# Environment variables
ENV ETCD_ENDPOINT=http://etcd:2379 \
    NODE_ID=geoip_enricher_v31_001 \
    LOG_LEVEL=INFO \
    PYTHONPATH=/app \
    GEOIP_DATA_PATH=/app/data/geoip

# AppArmor ready - no special privileges needed
# Security context will be handled at runtime (docker-compose/k8s)

# Run with exact command sequence specified
CMD ["python", "/app/geoip_enricher_v31_etcd.py", "/app/config/json/geoip_config_docker.json"]