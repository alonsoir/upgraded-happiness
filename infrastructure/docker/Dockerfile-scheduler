# =============================================================================
# Scheduler-firewall V3.1 ETCD - Ultra-secure Firewall Decision Engine Dockerfile
# Component: scheduler_firewall_v31_etcd.py
# Security: Non-root, AppArmor ready, minimal surface, precise file copying
# Base: python:3.12-slim (compatible con pyzmq + protobuf + ETCD)
# =============================================================================

# Stage 1: Build dependencies
FROM python:3.12-slim@sha256:af4e85f1cac90dd3771e47292ea7c8a9830abfabbe4faa5c53f158854c2e819d AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Install build dependencies - minimal set for ZMQ, protobuf and ETCD
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libffi-dev \
        libzmq3-dev && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Copy and install Python dependencies only
COPY infrastructure/docker/requirements-scheduler.txt ./requirements.txt
RUN pip install --user --no-warn-script-location -r requirements.txt

# Stage 2: Runtime - Ultra minimal
FROM python:3.12-slim@sha256:af4e85f1cac90dd3771e47292ea7c8a9830abfabbe4faa5c53f158854c2e819d AS runtime

# Create unprivileged user with specific UID/GID for security
RUN groupadd -g 1002 scheduler && \
    useradd -u 1002 -g 1002 -r -m -d /home/scheduler scheduler

# Set working directory
WORKDIR /app

# Install ONLY runtime dependencies for scheduler (ZMQ + ETCD)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libzmq5 && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Copy Python packages from builder
COPY --from=builder /root/.local /home/scheduler/.local

# Copy ONLY the specific files we need - precise file copying
# Main scheduler application
COPY core/scheduler_firewall_v31_etcd.py /app/

# Critical dependency - etcd crypto client (scheduler firewall specific)
COPY core/etcd_crypto_client_scheduler_firewall_fixed.py /app/

# Protocols (protobuf compiled files) with correct structure
COPY protocols/__init__.py /app/protocols/
COPY protocols/v3_1/__init__.py /app/protocols/v3_1/
COPY protocols/v3_1/network_security_clean_v31_pb2.py /app/protocols/v3_1/
COPY protocols/v3_1/firewall_commands_v31_pb2.py /app/protocols/v3_1/

# Configuration files - DOCKER SPECIFIC VERSIONS
COPY infrastructure/config/scheduler_firewall_config_docker.json /app/config/json/
COPY infrastructure/config/firewall_rules_config_docker.json /app/config/json/

# Create minimal directory structure and set ownership
RUN mkdir -p /app/logs /app/protobuf_storage/enriched /app/protobuf_storage/archived /app/axioms/pending /app/axioms/templates && \
    chown -R scheduler:scheduler /app /home/scheduler

# Switch to unprivileged user
USER scheduler

# Set PATH for user-installed packages
ENV PATH="/home/scheduler/.local/bin:${PATH}"

# Security: No new privileges
USER 1002:1002

# Health check - test scheduler readiness with ZMQ + ETCD connectivity
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import zmq; import etcd3; ctx=zmq.Context(); ctx.term(); print('Scheduler OK')" || exit 1

# Environment variables for scheduler firewall
ENV ETCD_ENDPOINT=http://etcd:2379 \
    NODE_ID=scheduler_firewall_001 \
    LOG_LEVEL=INFO \
    PYTHONPATH=/app \
    SCHEDULER_MODE=firewall_decision_engine \
    SCHEDULER_ROLE=distributed_decision_engine_etcd \
    ZMQ_IO_THREADS=2 \
    PROTOBUF_VALIDATE_UTF8=false

# AppArmor ready - no special privileges needed
# Security context will be handled at runtime (docker-compose/k8s)

# Run scheduler with both required configuration files
CMD ["python", "/app/scheduler_firewall_v31_etcd.py", "/app/config/json/scheduler_firewall_config_docker.json", "/app/config/json/firewall_rules_config_docker.json"]