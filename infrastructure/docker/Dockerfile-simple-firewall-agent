# =============================================================================
# simple_firewall_agent V3.1 ETCD - Ultra-secure firewall agent Dockerfile
# Component: simple_firewall_agent_v31_etcd.py
# Security: Non-root, AppArmor ready, minimal surface, precise file copying
# Base: python:3.12-slim (compatible con pyzmq + ML libs)
# =============================================================================

# Stage 1: Build dependencies
FROM python:3.12-slim@sha256:af4e85f1cac90dd3771e47292ea7c8a9830abfabbe4faa5c53f158854c2e819d AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Install build dependencies - minimal set for ML libraries
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        gfortran \
        libatlas-base-dev \
        liblapack-dev && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Copy and install Python dependencies only
COPY infrastructure/docker/requirements-simple-firewall-agent.txt ./requirements.txt
RUN pip install --user --no-warn-script-location -r requirements.txt

# Stage 2: Runtime - Ultra minimal
FROM python:3.12-slim@sha256:af4e85f1cac90dd3771e47292ea7c8a9830abfabbe4faa5c53f158854c2e819d AS runtime

# Create unprivileged user with specific UID/GID for security
RUN groupadd -g 1002 firewall && \
    useradd -u 1002 -g 1002 -r -m -d /home/firewall firewall

# Set working directory
WORKDIR /app

# Install ONLY runtime dependencies for ML (minimal math libraries)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libatlas3-base \
        libgfortran5 && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Copy Python packages from builder
COPY --from=builder /root/.local /home/firewall/.local

# Copy ONLY the specific files we need - precise file copying
# Main application
COPY core/simple_firewall_agent_v31_etcd.py /app/

# Critical dependency - etcd crypto client (ML specific)
COPY core/etcd_crypto_client_simple_firewall_agent_fixed.py /app/

# Protocols (protobuf compiled files) with correct structure
COPY protocols/__init__.py /app/protocols/
COPY protocols/v3_1/__init__.py /app/protocols/v3_1/
COPY protocols/v3_1/network_security_clean_v31_pb2.py /app/protocols/v3_1/
COPY protocols/v3_1/firewall_commands_v31_pb2.py /app/protocols/v3_1/

# Configuration files
COPY config/json/simple_firewall_agent_v31_etcd.json /app/config/json/
COPY config/json/firewall_rules_v31.json /app/config/json/

# Create minimal directory structure and set ownership
RUN mkdir -p /app/logs && \
    chown -R firewall:firewall /app /home/firewall

# Switch to unprivileged user
USER firewall

# Set PATH for user-installed packages
ENV PATH="/home/firewall/.local/bin:${PATH}"

# Security: No new privileges
USER 1002:1002

# Expose port (if ML detector has API endpoints)
EXPOSE 8082

# Minimal health check - test ML service readiness
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import sklearn, numpy; print('ML libs OK')" || exit 1

# Environment variables
ENV ETCD_ENDPOINT=http://etcd:2379 \
    NODE_ID=simple_firewall_agent_001 \
    LOG_LEVEL=INFO \
    PYTHONPATH=/app \
    FIREWALL_DATA_PATH=/app/data/firewall
    SKLEARN_ENABLE_RESOURCE_WARNINGS=false

# AppArmor ready - no special privileges needed
# Security context will be handled at runtime (docker-compose/k8s)

# Run with exact command sequence specified
CMD ["python", "/app/simple_firewall_agent_v31_etcd.py", "/app/config/json/simple_firewall_agent_v31_etcd.json","/app/config/firewall_rules_v31.json"]