{
  "deployment_metadata": {
    "environment": "{{ environment }}",
    "orchestrator": "{{ orchestrator | default('docker') }}",
    "namespace": "{{ namespace }}",
    "pod_id": "{{ pod_id }}",
    "container_name": "{{ container_name }}",
    "deployment_timestamp": "{{ deployment_timestamp }}",
    "config_version": "{{ config_version }}",
    "cluster_info": {
      "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster-v31') }}",
      "availability_zone": "{{ availability_zone | default('default') }}",
      "region": "{{ region | default('local') }}"
    },
    "runtime_metadata": {
      "_comment": "Estos campos se completan en runtime por el cliente etcd",
      "process_id": null,
      "startup_timestamp": null,
      "host_info": null
    }
  },

  "component": {
    "name": "lightweight_ml_detector_tricapa_v31_etcd",
    "version": "3.1.2-etcd-pubsub-optimized",
    "mode": "tricapa_json_controlled_pubsub_etcd"
  },

  "node_id": "{{ node_id | default('ml_detector_tricapa_v31_001') }}",
  "version": "3.1.2",
  "component_type": "ml_detector_tricapa_v31",

  "_comment_etcd_crypto": "🔐 ETCD CRYPTO - NUEVA SECCIÓN OBLIGATORIA - Sin token = NO ARRANCA",
  "etcd_crypto": {
    "etcd_host": "{{ etcd_service_name }}",
    "etcd_port": {{ etcd_port }},
    "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster-v31') }}",
    "node_id": "{{ node_id | default('ml_detector_tricapa_v31_001') }}"
  },

  "network": {
    "input_socket": {
      "address": "{{ services.geoip.downstream_service | default('geoip') }}",
      "port": {{ services.geoip.zmq_pub_port | default(5560) }},
      "mode": "connect",
      "socket_type": "PULL",
      "description": "Recibe eventos enriquecidos v3.1 del geoip_enricher con ETCD crypto"
    },
    "output_socket": {
      "address": "{{ service_name }}",
      "port": {{ services.ml_detector.zmq_pub_port | default(5580) }},
      "mode": "bind",
      "socket_type": "PUB",
      "_comment_change": "🔄 CAMBIO CRÍTICO: PUSH → PUB para múltiples suscriptores",
      "description": "Publica eventos v3.1 con análisis tricapa (dashboard + no-gui + futuros) con ETCD crypto"
    }
  },

  "zmq": {
    "input_port": {{ services.geoip.zmq_pub_port | default(5560) }},
    "output_port": {{ services.ml_detector.zmq_pub_port | default(5580) }},
    "_comment_hwm": "🚀 HWM OPTIMIZADO para PUB/SUB",
    "rcvhwm": 2000,
    "sndhwm": 3000,
    "_comment_sndhwm": "📈 SNDHWM aumentado para múltiples suscriptores",
    "_comment_timeouts": "Timeouts optimizados",
    "recv_timeout_ms": 100,
    "send_timeout_ms": 100,
    "_comment_buffers": "🔥 BUFFERS OPTIMIZADOS para PUB performance",
    "recv_buffer_size": 262144,
    "send_buffer_size": 262144,
    "_comment_send_buffer": "📦 Buffer de envío aumentado para PUB",
    "linger_ms": 0,
    "max_message_size": 50000,
    "pub_socket_optimizations": {
      "_comment": "🎯 OPTIMIZACIONES ESPECÍFICAS PARA PUB",
      "tcp_keepalive": true,
      "tcp_keepalive_idle": 300,
      "immediate": false,
      "conflate": false,
      "_comment_immediate": "false = mejor throughput para múltiples suscriptores",
      "_comment_conflate": "false = todos los eventos son importantes"
    },
    "vertical_scaling_optimizations": {
      "io_threads": {{ performance.io_threads | default(2) }},
      "max_sockets": 64,
      "tcp_keepalive": true,
      "tcp_keepalive_idle": 300,
      "immediate": false,
      "conflate": false
    },
    "immediate": false,
    "conflate": false
  },

  "backpressure": {
    "enabled": true,
    "_comment_optimized": "🚀 BACKPRESSURE OPTIMIZADO para PUB",
    "max_retries": 2,
    "retry_delays_ms": [1, 5],
    "drop_threshold_percent": 5.0,
    "activation_threshold": 20,
    "queue_full_strategy": "drop_oldest",
    "emergency_drop_enabled": true,
    "emergency_drop_threshold_percent": 70.0,
    "force_flush_interval_ms": 100,
    "_comment_pubsub": "Con PUB, el backpressure es menos crítico pero mantenemos control"
  },

  "processing": {
    "_comment_threads": "🧵 OPTIMIZADO: Hasta 3 workers según HW",
    "threads": {{ performance.worker_threads | default(4) }},
    "send_threads": 1,
    "ml_worker_processes": {{ performance.ml_worker_processes | default(3) }},
    "max_workers": {{ performance.max_workers | default(4) }},
    "_comment_queues": "📋 COLAS OPTIMIZADAS para PUB throughput",
    "internal_queue_size": 500,
    "protobuf_queue_size": 1000,
    "queue_timeout_seconds": 1.0,
    "performance_mode": "tricapa_optimized_pubsub_v312_etcd",
    "enable_heuristics": true,
    "enable_alerts": true,
    "max_processing_time": 5.0,
    "vertical_scaling": {
      "optimized_for_tricapa": true,
      "memory_buffer_multiplier": 1.5,
      "cpu_intensive_operations": true,
      "leave_cores_for_system": 1,
      "processing_batch_optimization": false
    },
    "queue_overflow_handling": {
      "strategy": "drop_oldest",
      "max_queue_wait_ms": 25,
      "emergency_drop_threshold_percent": 60.0,
      "log_drops": true
    },
    "message_validation": {
      "enabled": true,
      "max_protobuf_size": 45000,
      "validate_before_processing": true,
      "drop_oversized_messages": true,
      "log_validation_errors": false,
      "validate_v31_schema": true,
      "require_network_features": true
    }
  },

  "ml": {
    "enabled": true,
    "_comment_thresholds": "🎯 UMBRALES OPTIMIZADOS para mejor detección",
    "thresholds": {
      "level1_attack_threshold": {{ ml_thresholds.level1_attack | default(0.65) }},
      "level2_ddos_threshold": {{ ml_thresholds.level2_ddos | default(0.7) }},
      "level2_ransomware_threshold": {{ ml_thresholds.level2_ransomware | default(0.75) }},
      "level3_anomaly_threshold": {{ ml_thresholds.level3_anomaly | default(0.8) }}
    },
    "degraded_mode": {
      "min_models_required": 1,
      "continue_with_partial_models": true,
      "log_degraded_operations": false,
      "fallback_to_heuristics": true
    },
    "_comment_models_section": "🧠 MODELOS CONTROLADOS POR JSON - HW ACTUAL LIMITADO",
    "models": {
      "_comment_level1": "🥇 NIVEL 1: SIEMPRE ACTIVO (obligatorio)",
      "level1_attack_detector": {
        "enabled": true,
        "model_file": "rf_production_sniffer_compatible.joblib",
        "scaler_file": "rf_production_sniffer_compatible_scaler.joblib",
        "features_count": 23,
        "requires_scaling": true,
        "model_location": "production",
        "_comment": "Modelo base - siempre requerido"
      },
      "_comment_level2_ddos": "🔥 NIVEL 2 DDOS: Solo RF habilitado (LGB deshabilitado por HW)",
      "ddos_rf": {
        "enabled": {{ ml_models.ddos_rf_enabled | default(true) }},
        "model_file": "ddos_random_forest.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ddos",
        "_comment": "RF más eficiente para HW actual"
      },
      "ddos_lgb": {
        "enabled": {{ ml_models.ddos_lgb_enabled | default(false) }},
        "_comment_disabled": "❌ DESHABILITADO: LightGBM consume mucha memoria en HW actual",
        "model_file": "ddos_lightgbm.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ddos"
      },
      "_comment_level2_ransomware": "🦠 NIVEL 2 RANSOMWARE: Solo RF habilitado",
      "ransomware_rf": {
        "enabled": {{ ml_models.ransomware_rf_enabled | default(true) }},
        "model_file": "ransomware_random_forest.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ransomware",
        "_comment": "RF más eficiente para HW actual"
      },
      "ransomware_lgb": {
        "enabled": {{ ml_models.ransomware_lgb_enabled | default(false) }},
        "_comment_disabled": "❌ DESHABILITADO: LightGBM consume mucha memoria en HW actual",
        "model_file": "ransomware_lightgbm.joblib",
        "features_count": 82,
        "requires_scaling": false,
        "model_location": "tricapa",
        "threat_type": "ransomware"
      },
      "_comment_level3": "🔍 NIVEL 3: Solo internal habilitado (web deshabilitado por HW)",
      "internal_detector": {
        "enabled": {{ ml_models.internal_detector_enabled | default(true) }},
        "model_file": "internal_normal_detector.joblib",
        "features_count": 4,
        "requires_scaling": false,
        "model_location": "tricapa_or_production",
        "traffic_type": "internal",
        "_comment": "Detector interno - prioritario"
      },
      "web_detector": {
        "enabled": {{ ml_models.web_detector_enabled | default(false) }},
        "_comment_disabled": "❌ DESHABILITADO: Para reducir carga en HW actual",
        "model_file": "web_normal_detector.joblib",
        "features_count": 4,
        "requires_scaling": false,
        "model_location": "tricapa_or_production",
        "traffic_type": "web"
      }
    },
    "_comment_summary": "RESUMEN HW ACTUAL: 4/7 modelos habilitados (level1 + ddos_rf + ransomware_rf + internal_detector)",
    "feature_engineering": {
      "use_protobuf_v31_fields": true,
      "extract_82_features_from_network_features": true,
      "apply_feature_mapping_82_to_23": true,
      "apply_feature_mapping_82_to_4": true,
      "feature_mappings": {
        "82_to_23_enabled": true,
        "82_to_4_enabled": true,
        "validate_feature_counts": true,
        "pad_missing_features": true,
        "log_mapping_errors": false
      },
      "feature_extraction": {
        "ignore_repeated_double_fields": true,
        "use_network_features_struct": true,
        "validate_protobuf_fields": true,
        "handle_missing_fields_gracefully": true
      }
    }
  },

  "tricapa": {
    "enabled": true,
    "version": "3.1.2-json-controlled-pubsub-etcd",
    "architecture": {
      "level1_name": "General Attack Detection",
      "level1_description": "RF production model (23 features) - Initial attack detection",
      "level2_name": "Specialized Threat Classification - JSON CONTROLLED",
      "level2_description": "RF-only models según JSON (82 features) - DDOS vs Ransomware",
      "level3_name": "Normality Validation - JSON CONTROLLED",
      "level3_description": "Internal detector según JSON (4 features)"
    },
    "ensemble": {
      "enabled": true,
      "confidence_threshold": 0.7,
      "use_weighted_voting": false,
      "level2_combination_strategy": "max_score",
      "level3_activation_strategy": "traffic_type_based"
    },
    "model_paths": {
      "base_models_dir": "/app/models",
      "production_subdir": "production",
      "tricapa_subdir": "production/tricapa",
      "auto_discover_models": true,
      "fallback_model_locations": ["production", "tricapa"],
      "validate_model_files_on_startup": true
    },
    "performance": {
      "_comment_performance": "🚀 OPTIMIZACIONES DE PERFORMANCE para PUB + ETCD",
      "parallel_level2_predictions": false,
      "cache_feature_extractions": true,
      "cache_size": 500,
      "enable_model_warmup": true,
      "warmup_iterations": 3,
      "log_prediction_times": false
    },
    "failure_handling": {
      "continue_on_model_failure": true,
      "min_models_for_operation": 1,
      "level1_failure_strategy": "abort_analysis",
      "level2_failure_strategy": "continue_with_available",
      "level3_failure_strategy": "skip_level",
      "log_model_failures": true,
      "escalate_critical_failures": false
    }
  },

  "advanced_logging": {
    "enabled": {% if environment == "production" %}false{% else %}true{% endif %},
    "version": "3.1.2",
    "rag_logging": {
      "enabled": false,
      "_comment_disabled": "❌ DESHABILITADO para optimizar performance en HW actual"
    },
    "protobuf_logging": {
      "enabled": {{ advanced_logging.protobuf_enabled | default(true) }},
      "protobuf_base_dir": "/app/logs/proto",
      "file_format": "events_{HHMMSS}.proto",
      "directory_structure": "{year}/{month:02d}/{day:02d}",
      "append_mode": true,
      "compression_enabled": false,
      "max_file_size_mb": 50,
      "rotate_files": true
    },
    "indexing": {
      "enabled": false,
      "_comment_disabled": "❌ DESHABILITADO para optimizar performance"
    },
    "retention": {
      "enabled": true,
      "protobuf_logs_retention_days": {{ advanced_logging.retention_days | default(3) }},
      "cleanup_frequency": "daily"
    }
  },

  "logging": {
    "level": "{{ logging.level }}",
    "_comment_visible": "🔍 INFO level para VER SCORES ML",
    "format": "%(asctime)s - %(name)s - %(levelname)s - [tricapa_v31:{node_id}] [pid:{pid}] - %(message)s",
    "file": "/app/logs/tricapa_ml_detector_v31_etcd.log",
    "max_file_size_mb": 50,
    "backup_count": 3,
    "performance_logging": {
      "enabled": true,
      "log_slow_requests": true,
      "slow_request_threshold_ms": 100,
      "log_model_prediction_times": false,
      "log_feature_extraction_times": false
    },
    "console_logging": {
      "enabled": true,
      "level": "{{ logging.level }}"
    },
    "file_logging": {
      "enabled": true,
      "level": "{{ logging.level }}",
      "rotation_enabled": true
    }
  },

  "monitoring": {
    "stats_interval_seconds": {{ health_check.interval | default(60) }},
    "_comment_optimized": "🔒 60s interval para reducir overhead",
    "detailed_metrics": true,
    "track_tricapa_performance": true,
    "prometheus_metrics": {{ monitoring.prometheus_metrics | default(true) }},
    "metrics_port": {{ monitoring.metrics_port | default(9092) }},
    "component_health_check": {
      "enabled": true,
      "check_interval_seconds": {{ health_check.interval | default(120) }},
      "memory_threshold_mb": {{ performance.memory_limit_mb | default(256) }},
      "cpu_threshold_percent": 50.0,
      "model_response_time_threshold_ms": 50.0
    },
    "tricapa_specific_alerts": {
      "max_level1_failure_rate_percent": 10.0,
      "max_level2_ensemble_disagreement_percent": 50.0,
      "max_level3_skip_rate_percent": 80.0,
      "min_overall_model_availability_percent": 50.0,
      "max_degraded_mode_duration_minutes": 60
    },
    "alerts": {
      "max_queue_usage_percent": 50.0,
      "max_ml_failure_rate_percent": 25.0,
      "max_processing_latency_ms": 50.0,
      "max_backpressure_activations": 50,
      "max_drop_rate_percent": 10.0
    },
    "_comment_etcd_monitoring": "🔐 NUEVO: Monitoreo específico ETCD",
    "etcd_crypto_monitoring": {
      "track_pipeline_key_usage": true,
      "track_crypto_operations": true,
      "alert_on_etcd_failures": true,
      "max_crypto_failures_per_minute": 5,
      "etcd_connectivity_check_interval": 30
    }
  },

  "distributed": {
    "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster-v31') }}",
    "component_role": "ml_detector_tricapa_v31_json_controlled_pubsub_etcd",
    "enable_container_detection": true,
    "enable_system_info_collection": false,
    "pipeline_tracking": {
      "enabled": true,
      "track_latency": false,
      "track_component_path": true,
      "max_pipeline_hops": 6,
      "track_tricapa_stages": true,
      "track_etcd_crypto_operations": true
    }
  },

  "security": {
    "input_validation": {
      "enabled": true,
      "max_event_size_bytes": 50000,
      "validate_protobuf_schema": true,
      "validate_v31_schema_version": false,
      "sanitize_ml_scores": true,
      "reject_malformed_events": true,
      "min_required_features": 15
    },
    "rate_limiting": {
      "enabled": true,
      "max_events_per_second": 150,
      "burst_capacity": 300,
      "penalty_duration_seconds": 30
    },
    "_comment_etcd_security": "🔐 NUEVO: Seguridad específica ETCD",
    "etcd_crypto_security": {
      "validate_pipeline_keys": true,
      "rotate_keys_on_error": false,
      "secure_key_storage": true,
      "crypto_failure_threshold": 10
    },
    "privacy": {
      "anonymize_scores": {% if environment == "production" %}true{% else %}false{% endif %},
      "hash_model_predictions": {% if environment == "production" %}true{% else %}false{% endif %}
    }
  },

  "debug": {
    "enabled": {% if environment == "local" %}true{% else %}false{% endif %},
    "_comment_performance": "❌ DEBUG DESHABILITADO para máximo performance",
    "sample_events": false,
    "log_protobuf_details": false,
    "profile_performance": false,
    "log_ml_predictions": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_tricapa_stages": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_model_loading": true,
    "log_degraded_mode_operations": false,
    "_comment_etcd_debug": "🔐 Debug específico ETCD (solo para desarrollo)",
    "log_etcd_operations": {% if environment == "local" %}true{% else %}false{% endif %},
    "trace_pipeline_key_operations": false,
    "validate_crypto_tokens": true
  },

  "v31_enhancements": {
    "protobuf_v31_support": {
      "enabled": true,
      "use_network_features_struct": true,
      "validate_schema_version": false,
      "handle_backward_compatibility": false
    },
    "tricapa_architecture": {
      "enabled": true,
      "full_arsenal_mode": {{ ml_models.full_arsenal_mode | default(false) }},
      "_comment_json_controlled": "🎯 ARSENAL CONTROLADO POR JSON - no hardcoded",
      "parallel_level2_processing": false,
      "dynamic_model_selection": false
    },
    "advanced_logging_system": {
      "enabled": {% if environment == "production" %}false{% else %}true{% endif %},
      "_comment_disabled": "❌ Sistema de logging avanzado DESHABILITADO para performance"
    },
    "intelligent_degradation": {
      "enabled": true,
      "continue_with_partial_models": true,
      "intelligent_fallbacks": true,
      "graceful_failure_handling": true
    },
    "performance_optimizations": {
      "enabled": true,
      "feature_extraction_caching": true,
      "model_prediction_caching": false,
      "memory_efficient_operations": true,
      "optimized_protobuf_handling": true
    },
    "_comment_etcd_enhancements": "🔐 NUEVO: Mejoras específicas ETCD",
    "etcd_crypto_enhancements": {
      "enabled": true,
      "automatic_key_refresh": true,
      "failover_on_etcd_down": false,
      "pipeline_key_caching": true,
      "crypto_performance_optimization": true
    }
  },

  "_config_metadata": {
    "config_version": "{{ config_version }}",
    "created_for": "HW Actual - MacBook con limitaciones + PUB/SUB + ETCD crypto",
    "optimization_level": "HIGH_PERFORMANCE_PUBSUB_ETCD",
    "models_enabled_count": "{{ ml_models.enabled_count | default(4) }}",
    "models_disabled_count": "{{ ml_models.disabled_count | default(3) }}",
    "description": "Config para HW actual: 4 modelos eficientes + patrón PUB/SUB + integración ETCD obligatoria",
    "hw_profile": "LIMITED_MEMORY",
    "socket_pattern": "PUB/SUB",
    "crypto_integration": "ETCD_MANDATORY",
    "subscribers_supported": "dashboard + dashboard_nogui + futuros",
    "portability": "Para HW mejor, cambiar enabled:false -> enabled:true en modelos LGB y web_detector",
    "performance_target": "OPTIMIZED_THROUGHPUT_WITH_PUBSUB_DISTRIBUTION_ETCD_CRYPTO",
    "template_version": "3.1.0",
    "generated_from": "ml_detector_config-template.json",
    "compatible_orchestrators": ["docker", "k8s", "k3s", "podman"],
    "required_volumes": ["/app/logs", "/app/models"],
    "required_models": ["rf_production_sniffer_compatible.joblib"]
  },

  "_pubsub_info": {
    "publisher": "{{ node_id | default('ml_detector_tricapa_v31_001') }}",
    "publisher_port": {{ services.ml_detector.zmq_pub_port | default(5580) }},
    "socket_type": "PUB",
    "subscribers": [
      "dashboard_v31 (tcp://{{ service_name }}:{{ services.ml_detector.zmq_pub_port }} SUB)",
      "dashboard_nogui_v31 (tcp://{{ service_name }}:{{ services.ml_detector.zmq_pub_port }} SUB)",
      "future_components (tcp://{{ service_name }}:{{ services.ml_detector.zmq_pub_port }} SUB)"
    ],
    "scaling": "Añadir suscriptores sin modificar publisher",
    "benefits": [
      "Un solo puerto para múltiples consumidores",
      "Distribución automática de eventos",
      "Escalabilidad sin límites",
      "Pipeline modo terminal + GUI según necesidad"
    ]
  },

  "_comment_crypto": "🔐 CRYPTO ETCD - OBLIGATORIO: Descifrado GeoIP + Cifrado hacia Dashboard",
  "crypto": {
    "enabled": true,
    "role": "receiver_sender",
    "use_etcd_pipeline_key": true,
    "_comment_mandatory": "❌ Sin token ETCD = componente NO ARRANCA",
    "channels": {
      "input": {
        "decrypt": true,
        "description": "Descifrar eventos enriquecidos de GeoIP con ETCD pipeline key"
      },
      "output": {
        "encrypt": true,
        "description": "Cifrar análisis ML hacia múltiples suscriptores con ETCD pipeline key"
      }
    },
    "component_crypto_id": "{{ node_id | default('ml_detector_tricapa_v31_001') }}",
    "_comment_etcd": "Token rotativo distribuido automáticamente por ETCD - mucho más seguro que env vars"
  },

  "_etcd_integration_requirements": {
    "mandatory_dependencies": [
      "ETCD cluster running on {{ etcd_service_name }}:{{ etcd_port }}",
      "ETCD Crypto Coordinator active",
      "Protobuf v3_1 compatibility (no dots in folder names)",
      "etcd3-py with compatible protobuf version"
    ],
    "startup_sequence": [
      "1. ETCD cluster UP",
      "2. ETCD Crypto Coordinator UP",
      "3. ml_detector connects to ETCD",
      "4. Obtiene pipeline key rotativo",
      "5. Si NO obtiene key → SHUTDOWN",
      "6. Si obtiene key → INICIA con crypto habilitado"
    ],
    "failure_modes": {
      "no_etcd_connection": "SHUTDOWN - no fallback",
      "no_pipeline_key": "SHUTDOWN - no hardcoded keys",
      "crypto_disabled_in_json": "SHUTDOWN - crypto es obligatorio"
    }
  }
}