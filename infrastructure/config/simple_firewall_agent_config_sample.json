{
  "node_id": "simple_firewall_agent_001",
  "component": {
    "name": "simple_firewall_agent_v31_etcd",
    "version": "1.0.0-etcd-integration",
    "mode": "distributed_agent_etcd",
    "role": "simple_firewall_agent_nogui_etcd_dual",
    "description": "Simple Firewall Agent V3.1 with ETCD crypto + DUAL COMMUNICATION"
  },
  "_comment_etcd_crypto": "🔐 ETCD CRYPTO - OBLIGATORIO para DUAL COMMUNICATION",
  "etcd_crypto": {
    "etcd_host": "localhost",
    "etcd_port": 2379,
    "cluster_name": "upgraded-happiness-cluster-v31",
    "node_id": "simple_firewall_agent_001"
  },
  "_comment_dual_architecture": "🎯 DUAL COMMUNICATION: Scheduler (PUSH/PULL) + Dashboard (PUB/SUB)",
  "network": {
    "scheduler_commands": {
      "address": "localhost",
      "port": 5582,
      "_comment": "🔥 SCHEDULER→AGENT: Recibe comandos cifrados+comprimidos del scheduler",
      "mode": "bind",
      "socket_type": "PULL",
      "high_water_mark": 100,
      "expected_publishers": 1,
      "description": "Receives encrypted firewall commands from scheduler_firewall_etcd"
    },
    "scheduler_responses": {
      "address": "localhost",
      "port": 5581,
      "_comment": "🔄 AGENT→SCHEDULER: Envía respuestas cifradas+comprimidas al scheduler",
      "mode": "connect",
      "socket_type": "PUSH",
      "high_water_mark": 50,
      "expected_subscribers": 1,
      "description": "Sends encrypted responses to scheduler_firewall_etcd"
    },
    "dashboard_commands": {
      "address": "localhost",
      "port": 5583,
      "_comment": "📊 DASHBOARD→AGENT: Recibe comandos del dashboard",
      "mode": "connect",
      "socket_type": "SUB",
      "high_water_mark": 50,
      "expected_publishers": 1,
      "description": "Receives commands from dashboard via PUB/SUB pattern"
    },
    "dashboard_responses": {
      "address": "localhost",
      "port": 5584,
      "_comment": "📈 AGENT→DASHBOARD: Envía respuestas al dashboard",
      "mode": "bind",
      "socket_type": "PUB",
      "high_water_mark": 50,
      "expected_subscribers": 1,
      "description": "Publishes responses to dashboard via PUB/SUB pattern"
    },
    "scheduler_commands_input": {
      "description": "Input for firewall commands from scheduler",
      "address": "localhost",
      "port": 5582,
      "mode": "connect",
      "socket_type": "PULL",
      "high_water_mark": 200,
      "linger_ms": 1000,
      "recv_timeout_ms": 2000
    },
    "scheduler_responses_output": {
      "description": "Output for firewall responses to scheduler",
      "address": "localhost",
      "port": 5581,
      "mode": "connect",
      "socket_type": "PUSH",
      "high_water_mark": 200,
      "linger_ms": 1000,
      "send_timeout_ms": 1000
    },
    "status_endpoint": {
      "description": "Status monitoring endpoint",
      "address": "localhost",
      "port": 5585,
      "mode": "bind",
      "socket_type": "REP",
      "enabled": true
    }
  },
  "_dual_communication_flow": {
    "scheduler_flow": "scheduler:5582(PUSH+ENCRYPT) → agent:5582(PULL+DECRYPT) → agent:5581(PUSH+ENCRYPT) → scheduler:5581(PULL+DECRYPT)",
    "dashboard_flow": "dashboard:5583(PUB+ENCRYPT) → agent:5583(SUB+DECRYPT) → agent:5584(PUB+ENCRYPT) → dashboard:5584(SUB+DECRYPT)",
    "status": "✅ DUAL COMMUNICATION WITH ETCD CRYPTO"
  },
  "zmq": {
    "_comment_dual": "🔧 ZMQ configurado para DUAL COMMUNICATION + ETCD crypto",
    "context_io_threads": 2,
    "max_sockets": 64,
    "_comment_sockets": "🔧 Incrementado para 4 sockets DUAL",
    "tcp_keepalive": true,
    "tcp_keepalive_idle": 60,
    "immediate": true,
    "linger_ms": 0,
    "recv_timeout_ms": 1000,
    "send_timeout_ms": 1000,
    "recv_buffer_size": 65536,
    "send_buffer_size": 65536,
    "max_message_size": 50000,
    "agent_optimizations": {
      "_comment": "🎯 OPTIMIZACIONES ESPECÍFICAS AGENT DUAL",
      "conflate": false,
      "recovery_ivl": 5000,
      "sndbuf": 65536,
      "rcvbuf": 65536
    }
  },
  "processing": {
    "_comment_dual": "🔧 Processing para DUAL COMMUNICATION",
    "threads": {
      "scheduler_commands_consumer": 1,
      "dashboard_commands_consumer": 1,
      "command_processor": 1,
      "response_sender": 1,
      "cleanup_thread": 1
    },
    "command_queue_size": 50,
    "response_queue_size": 25,
    "max_concurrent_commands": 5,
    "_comment_concurrent": "🔧 Máximo 5 comandos concurrentes",
    "command_timeout_seconds": 30,
    "processing_batch_size": 1,
    "queue_management": {
      "enabled": true,
      "overflow_strategy": "drop_oldest",
      "max_wait_ms": 100,
      "emergency_drop_threshold": 80.0
    }
  },
  "firewall": {
    "safety_mode": "ULTRA_SECURE_V31",
    "dry_run_by_default": true,
    "max_rules_per_minute": 10,
    "max_concurrent_rules": 10,
    "default_rule_duration": 300,
    "rule_cleanup_interval": 60,
    "blocked_actions": [],
    "allowed_actions": [
      "MONITOR",
      "LIST_RULES",
      "BLOCK_IP",
      "RATE_LIMIT_IP",
      "ALLOW_IP_TEMP"
    ],
    "validation": {
      "validate_ip_addresses": true,
      "validate_ports": true,
      "validate_durations": true,
      "max_duration_seconds": 3600,
      "min_duration_seconds": 10
    }
  },
  "monitoring": {
    "stats_interval_seconds": 30,
    "detailed_metrics": true,
    "health_check_interval": 60,
    "alerts": {
      "max_queue_usage_percent": 70.0,
      "max_processing_latency_ms": 100.0,
      "max_error_rate_percent": 5.0,
      "max_memory_usage_mb": 128,
      "max_cpu_usage_percent": 30.0,
      "max_command_failures_per_minute": 3,
      "max_consecutive_errors": 3
    },
    "_comment_dual_monitoring": "🔐 Monitoreo específico DUAL + ETCD",
    "dual_communication_monitoring": {
      "track_scheduler_commands": true,
      "track_dashboard_commands": true,
      "track_dual_response_routing": true,
      "alert_on_communication_imbalance": true,
      "max_scheduler_commands_per_minute": 20,
      "max_dashboard_commands_per_minute": 10
    },
    "etcd_crypto_monitoring": {
      "track_pipeline_key_usage": true,
      "track_crypto_operations": true,
      "alert_on_etcd_failures": true,
      "max_crypto_failures_per_minute": 3,
      "etcd_connectivity_check_interval": 30
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - [node_id:{node_id}] [pid:{pid}] [SAFE_MODE_V31_ETCD] - %(message)s",
    "handlers": {
      "console": {
        "enabled": true,
        "level": "INFO"
      },
      "file": {
        "enabled": true,
        "path": "logs/simple_firewall_agent_etcd.log",
        "level": "INFO",
        "max_size": "50MB",
        "backup_count": 5,
        "rotation": "size"
      },
      "firewall_actions_log": {
        "enabled": true,
        "path": "logs/firewall_actions_v31_etcd.log",
        "level": "INFO",
        "log_all_actions": true,
        "log_dual_communication": true,
        "include_crypto_context": true
      }
    }
  },
  "security": {
    "input_validation": {
      "enabled": true,
      "max_command_size_bytes": 50000,
      "validate_command_structure": true,
      "validate_protobuf_integrity": true,
      "require_valid_node_id": true,
      "require_valid_timestamp": true
    },
    "command_safety": {
      "enabled": true,
      "require_dry_run_for_destructive": true,
      "max_ip_blocks_per_minute": 5,
      "require_reason_for_blocks": true,
      "validate_ip_ranges": true
    },
    "_comment_etcd_security": "🔐 Seguridad específica ETCD DUAL",
    "etcd_crypto_security": {
      "validate_pipeline_keys": true,
      "validate_dual_channel_integrity": true,
      "rotate_keys_on_error": false,
      "secure_key_storage": true,
      "crypto_failure_threshold": 5
    }
  },
  "distributed": {
    "cluster_name": "upgraded-happiness-cluster-v31",
    "component_role": "simple_firewall_agent_etcd_dual",
    "location": "zona_dmz_001",
    "enable_container_detection": true,
    "enable_system_info_collection": true,
    "pipeline_tracking": {
      "enabled": true,
      "track_latency": true,
      "track_component_path": true,
      "max_pipeline_hops": 4,
      "track_etcd_crypto_operations": true,
      "track_dual_communication_flow": true
    },
    "agent_specific": {
      "track_firewall_rule_applications": true,
      "track_command_sources": true,
      "track_dual_response_routing": true,
      "enable_firewall_analytics": true,
      "track_crypto_performance": true
    }
  },
  "debug": {
    "enabled": true,
    "_comment_debug": "🔧 Debug habilitado para diagnosticar problemas de compresión",
    "log_all_commands": true,
    "log_command_parsing": true,
    "log_protobuf_parsing": true,
    "log_compression_pipeline": true,
    "_comment_compression": "🔧 CRÍTICO: Debug del pipeline de descompresión",
    "performance_profiling": false,
    "_comment_etcd_debug": "🔐 Debug específico ETCD DUAL",
    "log_etcd_operations": true,
    "trace_pipeline_key_operations": true,
    "validate_crypto_tokens": true,
    "log_dual_communication_flow": true
  },
  "_config_metadata": {
    "config_version": "1.0.0-etcd-integration-dual",
    "created_for": "HW Actual - Simple Firewall Agent con ETCD crypto + DUAL COMMUNICATION",
    "optimization_level": "BALANCED_AGENT_ETCD_DUAL",
    "crypto_integration": "ETCD_MANDATORY_DUAL",
    "socket_pattern": "PULL/PUSH + SUB/PUB (DUAL)",
    "communication_pattern": "DUAL_SCHEDULER_DASHBOARD",
    "performance_target": "STABLE_FIREWALL_AGENT_WITH_ETCD_CRYPTO_DUAL",
    "last_modified": "2025-08-22T15:00:00Z"
  },
  "_comment_crypto": "🔐 CRYPTO ETCD DUAL - OBLIGATORIO: 4 canales cifrados+comprimidos",
  "crypto": {
    "enabled": true,
    "role": "receiver_sender_dual",
    "use_etcd_pipeline_key": true,
    "_comment_mandatory": "❌ Sin token ETCD = componente NO ARRANCA",
    "channels": {
      "scheduler_commands": {
        "decrypt": true,
        "decompress": true,
        "_comment_decompress": "🔧 CRÍTICO: ETCD debe descomprimir ANTES de parsing protobuf",
        "description": "Descifrar y descomprimir comandos del scheduler con ETCD pipeline key"
      },
      "scheduler_responses": {
        "encrypt": true,
        "compress": true,
        "_comment_compress": "🔧 CRÍTICO: ETCD debe comprimir DESPUÉS de serializar protobuf",
        "description": "Cifrar y comprimir respuestas al scheduler con ETCD pipeline key"
      },
      "dashboard_commands": {
        "decrypt": true,
        "decompress": true,
        "_comment_decompress": "🔧 CRÍTICO: ETCD debe descomprimir ANTES de parsing protobuf",
        "description": "Descifrar y descomprimir comandos del dashboard con ETCD pipeline key"
      },
      "dashboard_responses": {
        "encrypt": true,
        "compress": true,
        "_comment_compress": "🔧 CRÍTICO: ETCD debe comprimir DESPUÉS de serializar protobuf",
        "description": "Cifrar y comprimir respuestas al dashboard con ETCD pipeline key"
      }
    },
    "component_crypto_id": "simple_firewall_agent_001",
    "_comment_etcd": "Token rotativo distribuido automáticamente por ETCD para 4 canales DUAL"
  },
  "_etcd_integration_requirements": {
    "mandatory_dependencies": [
      "ETCD cluster running on localhost:2379",
      "ETCD Crypto Coordinator active",
      "Scheduler Firewall running on ports 5582/5581",
      "Dashboard running on ports 5583/5584 (optional)",
      "etcd3-py with compatible protobuf version"
    ],
    "startup_sequence": [
      "1. ETCD cluster UP",
      "2. ETCD Crypto Coordinator UP",
      "3. Agent connects to ETCD",
      "4. Obtiene pipeline key rotativo DUAL",
      "5. Si NO obtiene key → SHUTDOWN",
      "6. Si obtiene key → INICIA con crypto en 4 canales DUAL",
      "7. Scheduler/Dashboard pueden conectarse"
    ],
    "failure_modes": {
      "no_etcd_connection": "SHUTDOWN - no fallback",
      "no_pipeline_key": "SHUTDOWN - no hardcoded keys",
      "crypto_disabled_in_json": "SHUTDOWN - crypto es obligatorio para agent",
      "dual_channel_failure": "Continue with available channel if possible"
    }
  }
}