{
  "deployment_metadata": {
    "environment": "{{ environment }}",
    "orchestrator": "{{ orchestrator | default('docker') }}",
    "namespace": "{{ namespace }}",
    "pod_id": "{{ pod_id }}",
    "container_name": "{{ container_name }}",
    "deployment_timestamp": "{{ deployment_timestamp }}",
    "config_version": "{{ config_version }}",
    "cluster_info": {
      "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster-v31') }}",
      "availability_zone": "{{ availability_zone | default('default') }}",
      "region": "{{ region | default('local') }}"
    },
    "runtime_metadata": {
      "_comment": "Estos campos se completan en runtime por el cliente etcd",
      "process_id": null,
      "startup_timestamp": null,
      "host_info": null
    }
  },

  "node_id": "{{ node_id | default('scheduler_firewall_001') }}",
  "component": {
    "name": "scheduler_firewall_etcd",
    "version": "1.0.0-etcd-integration",
    "mode": "distributed_decision_engine_etcd",
    "role": "firewall_scheduler_nogui_etcd",
    "description": "JSON-controlled Firewall Decision Engine - No GUI + ETCD crypto"
  },

  "_comment_etcd_crypto": "🔐 ETCD CRYPTO - NUEVA SECCIÓN OBLIGATORIA - Sin token = NO ARRANCA",
  "etcd_crypto": {
    "etcd_host": "{{ etcd_service_name }}",
    "etcd_port": {{ etcd_port }},
    "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster-v31') }}",
    "node_id": "{{ node_id | default('scheduler_firewall_001') }}"
  },

  "_comment_architecture": "🎯 ARQUITECTURA: ml_detector:5580(PUB) → scheduler:5580(SUB) → firewall_agent:5582(PUSH) ↔ scheduler:5581(PULL)",
  "network": {
    "ml_events_input": {
      "address": "{{ services.ml_detector.downstream_service | default('ml-detector') }}",
      "port": {{ services.ml_detector.zmq_pub_port | default(5580) }},
      "_comment_fix": "🔧 CORRECTO: 5580 para recibir de ml_detector PUB con ETCD crypto",
      "mode": "connect",
      "socket_type": "SUB",
      "high_water_mark": 200,
      "_comment_hwm": "🔧 INCREMENTADO: De 1000 a 200 (menos agresivo)",
      "expected_publishers": 1,
      "description": "Receives encrypted ML events from ML Detector V3.1.2 tricapa (4 models) with ETCD crypto"
    },
    "firewall_commands_output": {
      "address": "{{ services.scheduler_firewall.downstream_service | default('simple-firewall-agent') }}",
      "port": {{ services.scheduler_firewall.zmq_push_port | default(5582) }},
      "_comment_fix": "🔧 REDUCIDO: Menos agresivo para no inundar agent",
      "mode": "connect",
      "socket_type": "PUSH",
      "high_water_mark": 50,
      "_comment_hwm": "🔧 REDUCIDO: De 100 a 50 para match agent capacity",
      "expected_subscribers": 1,
      "description": "Sends encrypted firewall commands to simple_firewall_agent with ETCD crypto"
    },
    "firewall_responses_input": {
      "address": "{{ service_name }}",
      "port": {{ services.scheduler_firewall.zmq_pull_port | default(5581) }},
      "_comment": "✅ CORRECTO: Recibe respuestas cifradas del firewall agent",
      "mode": "bind",
      "socket_type": "PULL",
      "high_water_mark": 150,
      "_comment_hwm": "🔧 INCREMENTADO: De 300 a 150 (menos agresivo)",
      "expected_publishers": 1,
      "description": "Receives encrypted responses from simple_firewall_agent with ETCD crypto"
    }
  },

  "_port_flow_etcd": {
    "step_1": "ml_detector:{{ services.ml_detector.zmq_pub_port }}(PUB+ENCRYPT) → scheduler:{{ services.ml_detector.zmq_pub_port }}(SUB+DECRYPT)",
    "step_2": "scheduler:{{ services.scheduler_firewall.zmq_push_port }}(PUSH+ENCRYPT) → firewall_agent:{{ services.scheduler_firewall.zmq_push_port }}(PULL+DECRYPT)",
    "step_3": "firewall_agent:{{ services.scheduler_firewall.zmq_pull_port }}(PUSH+ENCRYPT) → scheduler:{{ services.scheduler_firewall.zmq_pull_port }}(PULL+DECRYPT)",
    "status": "✅ ALL PORTS ALIGNED WITH ETCD CRYPTO"
  },

  "zmq": {
    "_comment_conservative": "🔧 CONFIGURACIÓN MENOS AGRESIVA basada en ml_detector con 4 modelos + ETCD crypto",
    "context_io_threads": {{ performance.io_threads | default(2) }},
    "max_sockets": 32,
    "tcp_keepalive": true,
    "tcp_keepalive_idle": 300,
    "immediate": false,
    "linger_ms": 0,
    "recv_timeout_ms": {{ zmq_timeouts.recv_timeout_ms | default(2000) }},
    "_comment_timeout1": "🔧 INCREMENTADO: De 100ms a 2000ms (menos agresivo)",
    "send_timeout_ms": {{ zmq_timeouts.send_timeout_ms | default(1000) }},
    "_comment_timeout2": "🔧 INCREMENTADO: De 50ms a 1000ms (menos agresivo)",
    "recv_buffer_size": 131072,
    "send_buffer_size": 262144,
    "max_message_size": 50000,
    "scheduler_optimizations": {
      "_comment": "🎯 OPTIMIZACIONES ESPECÍFICAS DEL SCHEDULER + ETCD",
      "conflate": false,
      "recovery_ivl": 10000,
      "sndbuf": 131072,
      "rcvbuf": 65536
    }
  },

  "processing": {
    "_comment_threads": "🔧 MENOS AGRESIVO: Threads reducidos pero colas más grandes",
    "threads": {
      "ml_events_consumers": {{ performance.ml_events_consumers | default(1) }},
      "firewall_command_producers": {{ performance.firewall_command_producers | default(1) }},
      "firewall_response_consumers": {{ performance.firewall_response_consumers | default(1) }}
    },
    "internal_queues": {
      "ml_events_queue_size": {{ processing_queues.ml_events_queue_size | default(100) }},
      "_comment_queue1": "🔧 INCREMENTADO: De 500 a 100 (más grande que antes)",
      "firewall_commands_queue_size": {{ processing_queues.firewall_commands_queue_size | default(50) }},
      "_comment_queue2": "🔧 INCREMENTADO: De 1000 a 50 (más grande que antes)",
      "firewall_responses_queue_size": {{ processing_queues.firewall_responses_queue_size | default(75) }},
      "_comment_queue3": "🔧 INCREMENTADO: De 200 a 75 (más grande que antes)"
    },
    "queue_management": {
      "enabled": true,
      "overflow_strategy": "drop_oldest",
      "max_wait_ms": {{ processing_queues.max_wait_ms | default(200) }},
      "_comment_wait": "🔧 INCREMENTADO: De 100ms a 200ms",
      "emergency_drop_threshold": {{ processing_queues.emergency_drop_threshold | default(90.0) }},
      "_comment_threshold": "🔧 INCREMENTADO: De 80% a 90%"
    },
    "decision_engine": {
      "max_decisions_per_second": {{ firewall_limits.max_decisions_per_second | default(5) }},
      "_comment_decisions": "🔧 REDUCIDO: De 10 a 5 (más conservador)",
      "decision_timeout_ms": {{ firewall_limits.decision_timeout_ms | default(200) }},
      "_comment_timeout": "🔧 INCREMENTADO: De 100ms a 200ms - más tiempo",
      "batch_processing": false,
      "cache_decisions": false
    },
    "backpressure": {
      "enabled": true,
      "max_retries": {{ backpressure.max_retries | default(2) }},
      "_comment_retries": "🔧 REDUCIDO: De 3 a 2 - menos agresivo",
      "retry_delays_ms": [50, 100],
      "_comment_delays": "🔧 REDUCIDO: Delays más rápidos",
      "drop_threshold_percent": {{ backpressure.drop_threshold_percent | default(20.0) }},
      "_comment_drop": "🔧 INCREMENTADO: De 15% a 20%",
      "activation_threshold": {{ backpressure.activation_threshold | default(20) }},
      "_comment_activation": "🔧 REDUCIDO: De 25 a 20 - activar antes",
      "queue_full_strategy": "drop_oldest"
    }
  },

  "monitoring": {
    "stats_interval_seconds": {{ health_check.interval | default(30) }},
    "_comment_stats": "🔧 REDUCIDO: De 60s a 30s para mejor monitoring",
    "detailed_metrics": true,
    "health_check_interval": {{ health_check.interval | default(120) }},
    "prometheus_metrics": {{ monitoring.prometheus_metrics | default(true) }},
    "metrics_port": {{ monitoring.metrics_port | default(9093) }},
    "alerts": {
      "max_queue_usage_percent": {{ monitoring_alerts.max_queue_usage_percent | default(80.0) }},
      "_comment_queue_alert": "🔧 INCREMENTADO: De 70% a 80%",
      "max_processing_latency_ms": {{ monitoring_alerts.max_processing_latency_ms | default(150.0) }},
      "_comment_latency_alert": "🔧 INCREMENTADO: De 100ms a 150ms",
      "max_error_rate_percent": {{ monitoring_alerts.max_error_rate_percent | default(8.0) }},
      "_comment_error_alert": "🔧 INCREMENTADO: De 5% a 8%",
      "max_memory_usage_mb": {{ performance.memory_limit_mb | default(256) }},
      "max_cpu_usage_percent": 40.0,
      "max_decision_latency_ms": 50.0,
      "min_decisions_per_minute": 1,
      "max_consecutive_errors": 5
    },
    "_comment_etcd_monitoring": "🔐 NUEVO: Monitoreo específico ETCD",
    "etcd_crypto_monitoring": {
      "track_pipeline_key_usage": true,
      "track_crypto_operations": true,
      "alert_on_etcd_failures": true,
      "max_crypto_failures_per_minute": 5,
      "etcd_connectivity_check_interval": 30
    }
  },

  "logging": {
    "level": "{{ logging.level }}",
    "format": "%(asctime)s - %(name)s - %(levelname)s - [scheduler_etcd:{node_id}] [pid:{pid}] - %(message)s",
    "handlers": {
      "console": {
        "enabled": true,
        "level": "{{ logging.level }}"
      },
      "file": {
        "enabled": true,
        "path": "/app/logs/scheduler_firewall_etcd.log",
        "level": "{{ logging.level }}",
        "max_size": "50MB",
        "backup_count": 5,
        "rotation": "size"
      },
      "decision_log": {
        "enabled": true,
        "path": "/app/logs/scheduler_decisions_etcd.log",
        "level": "{{ logging.level }}",
        "log_all_decisions": true,
        "log_rule_applications": true,
        "include_event_context": true,
        "log_crypto_operations": {% if environment == "local" %}true{% else %}false{% endif %}
      }
    }
  },

  "security": {
    "input_validation": {
      "enabled": true,
      "max_event_size_bytes": 50000,
      "validate_risk_scores": true,
      "risk_score_min": 0.0,
      "risk_score_max": 1.0,
      "validate_ip_addresses": true,
      "require_valid_ipv4": true
    },
    "decision_safety": {
      "enabled": true,
      "require_firewall_agent_validation": true,
      "max_block_decisions_per_minute": {{ firewall_limits.max_block_decisions_per_minute | default(10) }},
      "force_dry_run_above_rate": {{ firewall_limits.force_dry_run_above_rate | default(20) }}
    },
    "_comment_etcd_security": "🔐 NUEVO: Seguridad específica ETCD",
    "etcd_crypto_security": {
      "validate_pipeline_keys": true,
      "rotate_keys_on_error": false,
      "secure_key_storage": true,
      "crypto_failure_threshold": 10
    },
    "privacy": {
      "anonymize_decision_logs": {% if environment == "production" %}true{% else %}false{% endif %},
      "hash_ip_addresses": {% if environment == "production" %}true{% else %}false{% endif %}
    }
  },

  "distributed": {
    "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster-v31') }}",
    "component_role": "firewall_decision_engine_scheduler_etcd",
    "enable_container_detection": true,
    "enable_system_info_collection": true,
    "pipeline_tracking": {
      "enabled": true,
      "track_latency": true,
      "track_component_path": true,
      "max_pipeline_hops": 6,
      "track_etcd_crypto_operations": true
    },
    "scheduler_specific": {
      "track_decision_latency": true,
      "track_rule_applications": true,
      "track_firewall_responses": true,
      "enable_decision_analytics": true,
      "track_crypto_performance": true
    }
  },

  "decision_engine": {
    "rules_file_check_interval": {{ firewall_engine.rules_file_check_interval | default(30) }},
    "default_risk_threshold": {{ firewall_engine.default_risk_threshold | default(0.5) }},
    "emergency_mode_threshold": {{ firewall_engine.emergency_mode_threshold | default(0.95) }},
    "decision_cache": {
      "enabled": false
    },
    "fallback_behavior": {
      "enabled": true,
      "default_action": "{{ firewall_engine.default_action | default('MONITOR') }}",
      "default_duration": {{ firewall_engine.default_duration | default(300) }},
      "default_priority": "{{ firewall_engine.default_priority | default('MEDIUM') }}",
      "force_dry_run": {% if environment == "production" %}false{% else %}true{% endif %}
    }
  },

  "debug": {
    "enabled": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_all_events": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_decision_details": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_protobuf_parsing": false,
    "performance_profiling": {% if environment == "local" %}true{% else %}false{% endif %},
    "_comment_etcd_debug": "🔐 Debug específico ETCD (solo para desarrollo)",
    "log_etcd_operations": {% if environment == "local" %}true{% else %}false{% endif %},
    "trace_pipeline_key_operations": false,
    "validate_crypto_tokens": true
  },

  "_config_metadata": {
    "config_version": "{{ config_version }}",
    "created_for": "HW Actual - Scheduler con ETCD crypto obligatorio - MENOS AGRESIVO",
    "optimization_level": "BALANCED_SCHEDULER_ETCD",
    "crypto_integration": "ETCD_MANDATORY",
    "socket_pattern": "SUB/PUSH/PULL",
    "firewall_integration": "Ultra-secure JSON-controlled + ETCD crypto",
    "performance_target": "STABLE_DECISION_ENGINE_WITH_ETCD_CRYPTO_LESS_AGGRESSIVE",
    "template_version": "3.1.0",
    "generated_from": "scheduler_firewall_config-template.json",
    "compatible_orchestrators": ["docker", "k8s", "k3s", "podman"],
    "required_volumes": ["/app/logs", "/app/protobuf_storage", "/app/axioms"],
    "required_firewall_rules": true
  },

  "protobuf_storage": {
    "enabled": {{ protobuf_storage.enabled | default(true) }},
    "storage_path": "/app/protobuf_storage/enriched/",
    "archive_path": "/app/protobuf_storage/archived/",
    "file_naming": "enriched_{timestamp}_{event_id}.pb",
    "compression": "gzip",
    "retention_days": {{ protobuf_storage.retention_days | default(30) }},
    "auto_archive": true,
    "storage_conditions": {
      "store_all": false,
      "store_on_ml_confidence_below": {{ protobuf_storage.store_on_ml_confidence_below | default(0.8) }},
      "store_on_policy_override": true,
      "store_on_human_intervention": true,
      "store_on_retrain_candidate": true
    }
  },

  "axiom_generation": {
    "enabled": {{ axiom_generation.enabled | default(true) }},
    "axiom_output_path": "/app/axioms/pending/",
    "template_path": "/app/axioms/templates/axiom_template.json",
    "generate_conditions": {
      "always_generate": false,
      "on_ml_prediction": true,
      "on_policy_decision": true,
      "min_confidence_threshold": {{ axiom_generation.min_confidence_threshold | default(0.1) }}
    }
  },

  "_comment_crypto": "🔐 CRYPTO ETCD - OBLIGATORIO: ML events + Firewall commands (CRÍTICO)",
  "crypto": {
    "enabled": true,
    "role": "receiver_sender",
    "use_etcd_pipeline_key": true,
    "_comment_mandatory": "❌ Sin token ETCD = componente NO ARRANCA",
    "channels": {
      "ml_events_input": {
        "decrypt": true,
        "decompress": true,
        "_comment_decompress": "🔧 CRÍTICO: ETCD debe descomprimir ANTES de parsing protobuf",
        "description": "Descifrar y descomprimir eventos ML para análisis de decisiones con ETCD pipeline key"
      },
      "firewall_commands_output": {
        "encrypt": true,
        "compress": true,
        "_comment_compress": "🔧 CRÍTICO: ETCD debe comprimir DESPUÉS de serializar protobuf",
        "description": "Cifrar y comprimir comandos firewall hacia agente (CRÍTICO) con ETCD pipeline key"
      },
      "firewall_responses_input": {
        "decrypt": true,
        "decompress": true,
        "_comment_decompress": "🔧 CRÍTICO: ETCD debe descomprimir ANTES de parsing protobuf",
        "description": "Descifrar y descomprimir respuestas del agente firewall con ETCD pipeline key"
      }
    },
    "component_crypto_id": "{{ node_id | default('scheduler_firewall_001') }}",
    "_comment_etcd": "Token rotativo distribuido automáticamente por ETCD - mucho más seguro que config files"
  },

  "_etcd_integration_requirements": {
    "mandatory_dependencies": [
      "ETCD cluster running on {{ etcd_service_name }}:{{ etcd_port }}",
      "ETCD Crypto Coordinator active",
      "ML Detector tricapa running on port {{ services.ml_detector.zmq_pub_port }} (PUB)",
      "Simple Firewall Agent on ports {{ services.scheduler_firewall.zmq_push_port }}/{{ services.scheduler_firewall.zmq_pull_port }}",
      "etcd3-py with compatible protobuf version"
    ],
    "startup_sequence": [
      "1. ETCD cluster UP",
      "2. ETCD Crypto Coordinator UP",
      "3. ML Detector UP (publishing encrypted events)",
      "4. scheduler connects to ETCD",
      "5. Obtiene pipeline key rotativo",
      "6. Si NO obtiene key → SHUTDOWN",
      "7. Si obtiene key → INICIA con crypto en 3 canales",
      "8. Simple Firewall Agent UP (waiting for encrypted commands)"
    ],
    "failure_modes": {
      "no_etcd_connection": "SHUTDOWN - no fallback",
      "no_pipeline_key": "SHUTDOWN - no hardcoded keys",
      "crypto_disabled_in_json": "SHUTDOWN - crypto es obligatorio para firewall"
    }
  }
}