{
  "deployment_metadata": {
    "environment": "{{ environment }}",
    "orchestrator": "{{ orchestrator | default('docker') }}",
    "namespace": "{{ namespace }}",
    "pod_id": "{{ pod_id }}",
    "container_name": "{{ container_name }}",
    "deployment_timestamp": "{{ deployment_timestamp }}",
    "config_version": "{{ config_version }}",
    "cluster_info": {
      "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster') }}",
      "availability_zone": "{{ availability_zone | default('default') }}",
      "region": "{{ region | default('local') }}"
    },
    "runtime_metadata": {
      "_comment": "Estos campos se completan en runtime por el cliente etcd",
      "process_id": null,
      "startup_timestamp": null,
      "host_info": null
    }
  },

  "firewall_rules": {
    "version": "{{ firewall.rules_version | default('1.0.0-RELEASE') }}",
    "last_updated": "{{ deployment_timestamp }}",
    "description": "{{ firewall.rules_version | default('RELEASE-1.0.0') }} - Single source of truth firewall configuration",

    "rules": [
      {
        "rule_id": "rule_001_very_low_risk",
        "risk_range": [0, {{ firewall.risk_thresholds.very_low_max | default(19) }}],
        "action": "LIST_RULES",
        "description": "Riesgo muy bajo: Solo listar reglas activas para verificación",
        "params": {
          "timeout": {{ firewall.timeouts.list_rules | default(5) }},
          "log_level": "{{ logging.level | lower }}"
        },
        "priority": "LOW",
        "dry_run": {% if environment == "production" %}{{ firewall.force_dry_run_production | default('false') }}{% else %}true{% endif %},
        "enabled": true
      },
      {
        "rule_id": "rule_002_low_risk",
        "risk_range": [{{ firewall.risk_thresholds.low_min | default(20) }}, {{ firewall.risk_thresholds.low_max | default(39) }}],
        "action": "MONITOR",
        "description": "Riesgo bajo: Monitoreo básico de IP sospechosa",
        "params": {
          "duration": {{ firewall.durations.monitor_low | default(300) }},
          "log_level": "{{ logging.level | lower }}"
        },
        "priority": "LOW",
        "dry_run": {% if environment == "production" %}{{ firewall.force_dry_run_production | default('false') }}{% else %}true{% endif %},
        "enabled": true
      },
      {
        "rule_id": "rule_003_medium_risk",
        "risk_range": [{{ firewall.risk_thresholds.medium_min | default(40) }}, {{ firewall.risk_thresholds.medium_max | default(59) }}],
        "action": "MONITOR",
        "description": "Riesgo medio: Monitoreo intensivo con alertas",
        "params": {
          "duration": {{ firewall.durations.monitor_medium | default(600) }},
          "log_level": "warning",
          "enhanced_monitoring": {{ firewall.enhanced_monitoring | default(true) }}
        },
        "priority": "MEDIUM",
        "dry_run": {% if environment == "production" %}{{ firewall.force_dry_run_production | default('false') }}{% else %}true{% endif %},
        "enabled": true
      },
      {
        "rule_id": "rule_004_high_risk",
        "risk_range": [{{ firewall.risk_thresholds.high_min | default(60) }}, {{ firewall.risk_thresholds.high_max | default(79) }}],
        "action": "RATE_LIMIT",
        "description": "Riesgo alto: Rate limiting para reducir capacidad de ataque",
        "params": {
          "requests_per_minute": {{ firewall.rate_limit.requests_per_minute | default(10) }},
          "duration": {{ firewall.durations.rate_limit | default(1800) }},
          "burst_capacity": {{ firewall.rate_limit.burst_capacity | default(5) }}
        },
        "priority": "HIGH",
        "dry_run": {% if environment == "production" %}{{ firewall.rate_limit_dry_run | default('true') }}{% else %}true{% endif %},
        "enabled": {% if environment == "production" %}{{ firewall.enable_rate_limit_production | default('false') }}{% else %}false{% endif %},
        {% if environment != "production" %}"disabled_reason": "DEVELOPMENT MODE: Rate limiting disabled for safety"{% endif %}
      },
      {
        "rule_id": "rule_005_critical_risk",
        "risk_range": [{{ firewall.risk_thresholds.critical_min | default(80) }}, {{ firewall.risk_thresholds.critical_max | default(100) }}],
        "action": "BLOCK_IP",
        "description": "Riesgo crítico: Bloqueo inmediato de IP maliciosa",
        "params": {
          "duration": {{ firewall.durations.block_ip | default(3600) }},
          "immediate_action": {{ firewall.immediate_action | default(true) }}
        },
        "priority": "CRITICAL",
        "dry_run": {% if environment == "production" %}{{ firewall.block_ip_dry_run | default('true') }}{% else %}true{% endif %},
        "enabled": {% if environment == "production" %}{{ firewall.enable_block_ip_production | default('false') }}{% else %}false{% endif %},
        {% if environment != "production" %}"disabled_reason": "DEVELOPMENT MODE: IP blocking disabled for safety"{% endif %}
      }
    ],

    "manual_actions": {
      "LIST_RULES": {
        "description": "Listar reglas activas - SEGURO V3.1",
        "safety_level": "SAFE",
        "enabled": true,
        "requires_confirmation": false
      },
      "MONITOR": {
        "description": "Monitorear IP - SEGURO V3.1",
        "safety_level": "SAFE",
        "enabled": true,
        "requires_confirmation": false
      },
      "RATE_LIMIT": {
        "description": "Rate limiting - PELIGROSO - Solo con aprobación humana",
        "safety_level": "DANGEROUS",
        "enabled": {% if environment == "production" %}{{ firewall.enable_rate_limit_manual | default('false') }}{% else %}false{% endif %},
        "requires_confirmation": true,
        {% if environment != "production" %}"disabled_reason": "DEVELOPMENT MODE: Rate limiting disabled for safety"{% endif %}
      },
      "BLOCK_IP": {
        "description": "Bloquear IP - MUY PELIGROSO - Solo emergencias",
        "safety_level": "CRITICAL",
        "enabled": {% if environment == "production" %}{{ firewall.enable_block_ip_manual | default('false') }}{% else %}false{% endif %},
        "requires_confirmation": true,
        "requires_double_confirmation": {% if environment == "production" %}true{% else %}true{% endif %},
        {% if environment != "production" %}"disabled_reason": "DEVELOPMENT MODE: IP blocking disabled for safety"{% endif %}
      },
      "EMERGENCY_UNBLOCK": {
        "description": "Desbloquear IP en emergencia - Para corregir errores",
        "safety_level": "EMERGENCY_RECOVERY",
        "enabled": true,
        "requires_confirmation": true
      }
    },

    "agents_fleet": {
{% for agent in firewall.agents %}
      "{{ agent.node_id }}": {
        "node_id": "{{ agent.node_id }}",
        "version": "{{ firewall.agent_version | default('3.1.0') }}",
        "location": "{{ agent.location | default('zona_dmz_001') }}",
        "status": "{{ agent.status | default('active') }}",

        "network_endpoints": {
          "scheduler_communication": {
            "commands_input": "tcp://{{ agent.service_name | default('firewall-agent') }}:{{ agent.scheduler_commands_port }}",
            "responses_output": "tcp://{{ agent.service_name | default('firewall-agent') }}:{{ agent.scheduler_responses_port }}",
            "pattern": "PUSH/PULL"
          },
          "dashboard_communication": {
            "commands_input": "tcp://{{ agent.service_name | default('firewall-agent') }}:{{ agent.dashboard_commands_port }}",
            "responses_output": "tcp://{{ agent.service_name | default('firewall-agent') }}:{{ agent.dashboard_responses_port }}",
            "pattern": "PUB/SUB"
          }
        },

        "capabilities": {
          "allowed_actions": {% if environment == "production" %}{{ agent.allowed_actions_production | default('["MONITOR", "LIST_RULES", "RATE_LIMIT"]') | tojson }}{% else %}["MONITOR", "LIST_RULES"]{% endif %},
          "blocked_actions": {% if environment == "production" %}{{ agent.blocked_actions_production | default('["FLUSH_RULES"]') | tojson }}{% else %}["BLOCK_IP", "RATE_LIMIT", "FLUSH_RULES"]{% endif %},
          "max_concurrent_rules": {{ agent.max_concurrent_rules | default(10) }},
          "default_rule_duration": {{ agent.default_rule_duration | default(60) }}
        },

        "security_profile": {
          "safety_mode": "{{ firewall.safety_mode | default('ULTRA_SECURE_V31') }}",
          "auto_force_dry_run": {% if environment == "production" %}{{ firewall.auto_force_dry_run_production | default('false') }}{% else %}true{% endif %},
          "environment_detection": true
        }
      }{% if not loop.last %},{% endif %}
{% endfor %}
    },

    "global_settings": {
      "security": {
        "force_dry_run_global": {% if environment == "production" %}{{ firewall.force_dry_run_global_production | default('false') }}{% else %}true{% endif %},
        "max_rule_duration_global": {{ firewall.max_rule_duration_global | default(300) }},
        "require_confirmation_above_risk": {{ firewall.confirmation_risk_threshold | default(0.6) }},
        "development_mode": {% if environment == "local" %}true{% else %}false{% endif %}
      },

      "coordination": {
        "scheduler_max_risk_auto": {{ firewall.scheduler_max_risk_auto | default(0.6) }},
        "human_oversight_required": {% if environment == "production" %}{{ firewall.human_oversight_required | default('true') }}{% else %}true{% endif %},
        "audit_all_actions": true
      }
    }
  },

  "_config_metadata": {
    "template_version": "1.0.0-RELEASE",
    "generated_from": "firewall_rules_config_template.json",
    "config_version": "{{ config_version }}",
    "compatible_orchestrators": ["docker", "k8s", "k3s", "podman"],
    "required_volumes": ["/app/logs"],
    "required_environment_vars": [],
    "required_external_services": ["etcd_cluster", "scheduler", "dashboard"],
    "security_profile": "{{ firewall.safety_mode | default('ULTRA_SECURE_V31') }}",
    "safety_features": [
      "force_dry_run_development",
      "confirmation_required_dangerous_actions",
      "double_confirmation_critical_actions",
      "emergency_unblock_available",
      "audit_all_actions",
      "environment_detection"
    ],
    "last_modified": "{{ deployment_timestamp }}"
  }
}