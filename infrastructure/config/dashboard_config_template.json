{
  "deployment_metadata": {
    "environment": "{{ environment }}",
    "orchestrator": "{{ orchestrator | default('docker') }}",
    "namespace": "{{ namespace }}",
    "pod_id": "{{ pod_id }}",
    "container_name": "{{ container_name }}",
    "deployment_timestamp": "{{ deployment_timestamp }}",
    "config_version": "{{ config_version }}",
    "cluster_info": {
      "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster') }}",
      "availability_zone": "{{ availability_zone | default('default') }}",
      "region": "{{ region | default('local') }}"
    },
    "runtime_metadata": {
      "_comment": "Estos campos se completan en runtime por el cliente etcd",
      "process_id": null,
      "startup_timestamp": null,
      "host_info": null
    }
  },

  "node_id": "{{ node_id | default('dashboard_main_v31_etcd_001') }}",
  "component": {
    "name": "dashboard_scada_v31_etcd",
    "version": "3.1.0-etcd-integration",
    "mode": "distributed_monitoring_etcd",
    "role": "dashboard_scada_nogui_etcd",
    "description": "Dashboard SCADA V3.1 con ETCD crypto obligatorio + fleet management + web interface"
  },

  "_comment_etcd_crypto": "🔐 ETCD CRYPTO - NUEVA SECCIÓN OBLIGATORIA - Sin token = NO ARRANCA",
  "etcd_crypto": {
    "etcd_host": "{{ etcd_service_name }}",
    "etcd_port": {{ etcd_port }},
    "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster') }}",
    "node_id": "{{ node_id | default('dashboard_main_v31_etcd_001') }}"
  },

  "_comment_architecture": "🎯 ARQUITECTURA: ml_detector:5580(PUB) → dashboard:5580(SUB) ↔ firewall_agents:5590/5591(PUSH/PULL) + web:8080",
  "network": {
    "ml_events_input": {
      "address": "{{ services.ml_detector.service_name | default('ml-detector') }}",
      "port": {{ services.ml_detector.zmq_pub_port | default(5580) }},
      "_comment_fix": "🔧 CORRECTO: 5580 para recibir de ml_detector PUB con ETCD crypto",
      "mode": "connect",
      "socket_type": "SUB",
      "high_water_mark": {{ performance.dashboard_hwm | default(500) }},
      "_comment_hwm": "🔧 BALANCED: HWM para dashboard monitoring",
      "expected_publishers": 1,
      "description": "Receives encrypted ML events from ML Detector V3.1.2 tricapa with ETCD crypto"
    },
    "scheduler_communication": {
      "enabled": {{ dashboard.scheduler_communication | default(false) }},
      "_comment_optional": "🔧 OPCIONAL: Comunicación con scheduler si se necesita",
      "address": "{{ services.scheduler.service_name | default('scheduler') }}",
      "port": {{ services.scheduler.dashboard_port | default(5585) }},
      "mode": "connect",
      "socket_type": "REQ",
      "high_water_mark": 100,
      "request_timeout_ms": 5000,
      "description": "Optional encrypted communication with scheduler_firewall with ETCD crypto"
    }
  },

  "_port_flow_etcd": {
    "step_1": "ml_detector:{{ services.ml_detector.zmq_pub_port | default(5580) }}(PUB+ENCRYPT) → dashboard:{{ services.ml_detector.zmq_pub_port | default(5580) }}(SUB+DECRYPT)",
    "step_2": "dashboard:{{ services.dashboard.firewall_commands_port | default(5590) }}(PUSH+ENCRYPT) → firewall_agents:{{ services.dashboard.firewall_commands_port | default(5590) }}(PULL+DECRYPT)",
    "step_3": "firewall_agents:{{ services.dashboard.firewall_responses_port | default(5591) }}(PUSH+ENCRYPT) → dashboard:{{ services.dashboard.firewall_responses_port | default(5591) }}(PULL+DECRYPT)",
    "step_4": "dashboard:{{ dashboard.web_port | default(8080) }}(HTTP) → web_interface (local only)",
    "status": "✅ ALL PORTS ALIGNED WITH ETCD CRYPTO"
  },

  "firewall_fleet": {
    "enabled": {{ dashboard.fleet_management | default(true) }},
    "description": "Fleet management para múltiples agentes firewall V3.1 con ETCD crypto",
    "_comment": "🔥 FLEET CIFRADA COMPLETA - ETCD maneja crypto automáticamente",
    "agents": [
      {
        "node_id": "{{ firewall_agent.node_id | default('simple_firewall_agent_001') }}",
        "status": "active",
        "network_endpoints": {
          "dashboard_communication": {
            "commands_input": "tcp://{{ firewall_agent.service_name | default('firewall-agent') }}:{{ services.firewall_agent.dashboard_commands_port | default(5583) }}",
            "responses_output": "tcp://{{ firewall_agent.service_name | default('firewall-agent') }}:{{ services.firewall_agent.dashboard_responses_port | default(5584) }}"
          }
        },
        "capabilities": {
          "allowed_actions": [
            "BLOCK_IP",
            "RATE_LIMIT_IP",
            "LIST_RULES",
            "ALLOW_IP_TEMP"
          ]
        }
      }
    ],
    "fleet_management": {
      "auto_discovery": {{ dashboard.auto_discovery | default(false) }},
      "_comment": "🔧 Fleet discovery manual via JSON - más seguro",
      "health_check_interval": {{ dashboard.health_check_interval | default(60) }},
      "command_timeout": {{ dashboard.command_timeout | default(10) }},
      "max_retry_attempts": {{ dashboard.max_retry_attempts | default(3) }},
      "load_balancing": "{{ dashboard.load_balancing | default('round_robin') }}",
      "batch_commands": {{ dashboard.batch_commands | default(false) }}
    }
  },

  "_port_flow_etcd_FIXED": {
    "step_1": "ml_detector:{{ services.ml_detector.zmq_pub_port | default(5580) }}(PUB+ENCRYPT) → dashboard:{{ services.ml_detector.zmq_pub_port | default(5580) }}(SUB+DECRYPT)",
    "step_2": "dashboard:{{ services.firewall_agent.dashboard_commands_port | default(5583) }}(PUB+ENCRYPT) → firewall_agents:{{ services.firewall_agent.dashboard_commands_port | default(5583) }}(SUB+DECRYPT)",
    "step_3": "firewall_agents:{{ services.firewall_agent.dashboard_responses_port | default(5584) }}(PUB+ENCRYPT) → dashboard:{{ services.firewall_agent.dashboard_responses_port | default(5584) }}(SUB+DECRYPT)",
    "step_4": "dashboard:{{ dashboard.web_port | default(8080) }}(HTTP) → web_interface (local only)",
    "status": "✅ ALL PORTS NOW ALIGNED WITH FIREWALL AGENT"
  },

  "web_server": {
    "host": "{{ dashboard.web_host | default('0.0.0.0') }}",
    "port": {{ dashboard.web_port | default(8080) }},
    "_comment_host": "🌐 0.0.0.0 para K8s compatibility",
    "debug": {% if environment == "local" %}true{% else %}false{% endif %},
    "threaded": true,
    "use_reloader": {% if environment == "local" %}true{% else %}false{% endif %},
    "_comment_reloader": "🔧 Disabled para production",
    "cors": {
      "enabled": true,
      "origins": {% if environment == "production" %}["{{ dashboard.allowed_origins | default('https://dashboard.yourcompany.com') }}"]{% else %}["*"]{% endif %},
      "_comment_origins": "🔧 * para desarrollo - restringir en producción",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "headers": [
        "Content-Type",
        "Authorization",
        "X-Requested-With"
      ]
    },
    "security": {
      "rate_limiting": {
        "enabled": true,
        "requests_per_minute": {{ dashboard.rate_limit_rpm | default(120) }},
        "burst": {{ dashboard.rate_limit_burst | default(30) }},
        "_comment": "🔧 Aumentado para dashboard interactivo"
      },
      "csrf_protection": {% if environment == "production" %}true{% else %}false{% endif %},
      "_comment_csrf": "🔧 Disabled para API usage en desarrollo",
      "secure_headers": true,
      "max_request_size": "{{ dashboard.max_request_size | default('10MB') }}"
    },
    "static_files": {
      "enabled": true,
      "folder": "web/static",
      "url_path": "/static",
      "cache_timeout": {% if environment == "production" %}3600{% else %}300{% endif %}
    },
    "templates": {
      "enabled": true,
      "folder": "web/templates",
      "auto_reload": {% if environment == "local" %}true{% else %}false{% endif %}
    }
  },

  "zmq": {
    "_comment_conservative": "🔧 CONFIGURACIÓN BALANCEADA para dashboard con ETCD crypto",
    "context_io_threads": {{ performance.zmq_io_threads | default(2) }},
    "_comment_threads": "🔧 2 threads para manejar crypto + UI simultaneously",
    "max_sockets": {{ performance.max_sockets | default(16) }},
    "_comment_sockets": "🔧 Reducido - dashboard usa menos sockets que scheduler",
    "tcp_keepalive": true,
    "tcp_keepalive_idle": 300,
    "immediate": false,
    "linger_ms": {{ performance.linger_ms | default(1000) }},
    "_comment_linger": "🔧 1s para permitir envío de mensajes pendientes",
    "recv_timeout_ms": {{ performance.recv_timeout_ms | default(2000) }},
    "_comment_timeout1": "🔧 2s timeout para dashboard - menos agresivo",
    "send_timeout_ms": {{ performance.send_timeout_ms | default(1000) }},
    "_comment_timeout2": "🔧 1s send timeout",
    "recv_buffer_size": {{ performance.recv_buffer_size | default(65536) }},
    "send_buffer_size": {{ performance.send_buffer_size | default(131072) }},
    "max_message_size": {{ performance.max_message_size | default(50000) }},
    "dashboard_optimizations": {
      "_comment": "🎯 OPTIMIZACIONES ESPECÍFICAS DASHBOARD + ETCD",
      "conflate": false,
      "recovery_ivl": 10000,
      "sndbuf": 65536,
      "rcvbuf": 65536,
      "subscribe_all": true
    }
  },

  "processing": {
    "_comment_threads": "🔧 DASHBOARD: Menos threads que scheduler - foco en visualización",
    "threads": {
      "ml_events_consumers": {{ performance.ml_events_threads | default(1) }},
      "_comment_ml": "🔧 1 thread para procesar eventos ML",
      "fleet_command_senders": {{ performance.fleet_command_threads | default(1) }},
      "_comment_fleet_out": "🔧 1 thread para enviar comandos a fleet",
      "fleet_response_consumers": {{ performance.fleet_response_threads | default(1) }},
      "_comment_fleet_in": "🔧 1 thread para recibir respuestas de fleet",
      "web_workers": {{ performance.web_workers | default(2) }},
      "_comment_web": "🔧 2 threads para web server si es necesario"
    },
    "internal_queues": {
      "ml_events_queue_size": {{ performance.ml_events_queue | default(200) }},
      "_comment_queue1": "🔧 Cola eventos ML para dashboard",
      "fleet_commands_queue_size": {{ performance.fleet_commands_queue | default(50) }},
      "_comment_queue2": "🔧 Cola comandos hacia fleet",
      "fleet_responses_queue_size": {{ performance.fleet_responses_queue | default(100) }},
      "_comment_queue3": "🔧 Cola respuestas desde fleet",
      "web_events_queue_size": {{ performance.web_events_queue | default(500) }},
      "_comment_queue4": "🔧 Cola para eventos hacia web interface"
    },
    "queue_management": {
      "enabled": true,
      "overflow_strategy": "{{ dashboard.overflow_strategy | default('drop_oldest') }}",
      "max_wait_ms": {{ performance.max_wait_ms | default(500) }},
      "_comment_wait": "🔧 500ms wait para dashboard",
      "emergency_drop_threshold": {{ performance.emergency_drop_threshold | default(85.0) }},
      "_comment_threshold": "🔧 85% threshold"
    },
    "event_processing": {
      "max_events_in_memory": {{ performance.max_events_memory | default(1000) }},
      "_comment_memory": "🔧 1000 eventos en memoria para visualización",
      "event_retention_hours": {{ dashboard.event_retention_hours | default(4) }},
      "_comment_retention": "🔧 4 horas de retención para dashboard",
      "auto_cleanup_enabled": true,
      "duplicate_detection": true,
      "event_aggregation": {{ dashboard.event_aggregation | default(true) }}
    },
    "backpressure": {
      "enabled": true,
      "max_retries": {{ performance.backpressure_retries | default(2) }},
      "_comment_retries": "🔧 Menos retries para dashboard",
      "retry_delays_ms": [
        {{ performance.retry_delay_1 | default(50) }},
        {{ performance.retry_delay_2 | default(100) }}
      ],
      "_comment_delays": "🔧 Delays más rápidos",
      "drop_threshold_percent": {{ performance.drop_threshold | default(20.0) }},
      "_comment_drop": "🔧 20% threshold",
      "activation_threshold": {{ performance.activation_threshold | default(30) }},
      "_comment_activation": "🔧 Threshold 30",
      "queue_full_strategy": "{{ dashboard.queue_full_strategy | default('drop_oldest') }}"
    }
  },

  "monitoring": {
    "stats_interval_seconds": {{ monitoring.stats_interval | default(30) }},
    "_comment_stats": "🔧 30s para dashboard monitoring",
    "detailed_metrics": {{ monitoring.detailed_metrics | default(true) }},
    "health_check_interval": {{ health_check.interval | default(120) }},
    "performance_tracking": {
      "enabled": true,
      "track_event_processing_latency": true,
      "track_fleet_command_latency": true,
      "track_web_response_time": true,
      "track_queue_utilization": true
    },
    "alerts": {
      "max_queue_usage_percent": {{ monitoring.max_queue_usage | default(75.0) }},
      "_comment_queue_alert": "🔧 75% para dashboard",
      "max_processing_latency_ms": {{ monitoring.max_processing_latency | default(200.0) }},
      "_comment_latency_alert": "🔧 200ms para dashboard",
      "max_error_rate_percent": {{ monitoring.max_error_rate | default(10.0) }},
      "_comment_error_alert": "🔧 10% error rate",
      "max_memory_usage_mb": {{ performance.memory_limit_mb | default(512) }},
      "max_cpu_usage_percent": {{ monitoring.max_cpu_usage | default(50.0) }},
      "_comment_cpu": "🔧 50% CPU para dashboard",
      "max_web_response_time_ms": {{ dashboard.max_web_response_time | default(1000.0) }},
      "min_events_per_minute": {{ monitoring.min_events_per_minute | default(0) }},
      "_comment_min_events": "🔧 0 mínimo - dashboard puede estar sin eventos",
      "max_consecutive_errors": {{ monitoring.max_consecutive_errors | default(10) }},
      "fleet_health_check_failures": {{ dashboard.max_fleet_failures | default(5) }}
    },
    "_comment_etcd_monitoring": "🔐 NUEVO: Monitoreo específico ETCD",
    "etcd_crypto_monitoring": {
      "track_pipeline_key_usage": true,
      "track_crypto_operations": true,
      "alert_on_etcd_failures": true,
      "max_crypto_failures_per_minute": {{ monitoring.max_crypto_failures | default(5) }},
      "etcd_connectivity_check_interval": {{ monitoring.etcd_check_interval | default(30) }}
    },
    "prometheus_metrics": {{ monitoring.prometheus_metrics | default(true) }},
    "metrics_port": {{ monitoring.metrics_port | default(9090) }}
  },

  "logging": {
    "level": "{{ logging.level }}",
    "format": "%(asctime)s - %(name)s - %(levelname)s - [dashboard_etcd:{{ node_id | default('dashboard_main_v31_etcd_001') }}] [pid:{pid}] - %(message)s",
    "handlers": {
      "console": {
        "enabled": true,
        "level": "{{ logging.level }}",
        "colored": {% if environment == "local" %}true{% else %}false{% endif %}
      },
      "file": {
        "enabled": true,
        "path": "./logs/dashboard_v31_etcd.log",
        "level": "{{ logging.file_level | default('INFO') }}",
        "max_size": "{{ logging.max_size | default('50MB') }}",
        "backup_count": {{ logging.backup_count | default(5) }},
        "rotation": "size"
      },
      "web_access_log": {
        "enabled": {{ dashboard.log_web_access | default(true) }},
        "path": "./logs/dashboard_web_access.log",
        "level": "INFO",
        "log_requests": true,
        "log_responses": {% if environment == "local" %}true{% else %}false{% endif %},
        "_comment": "🌐 Log web requests para debugging"
      },
      "fleet_communication_log": {
        "enabled": {{ dashboard.log_fleet_communication | default(true) }},
        "path": "./logs/dashboard_fleet_comm.log",
        "level": "{{ logging.fleet_comm_level | default('INFO') }}",
        "log_commands_sent": true,
        "log_responses_received": true,
        "log_crypto_operations": {% if environment == "local" %}true{% else %}false{% endif %},
        "_comment": "🔥 Log comunicación con fleet cifrada"
      }
    }
  },

  "security": {
    "input_validation": {
      "enabled": true,
      "max_event_size_bytes": {{ security.max_event_size | default(50000) }},
      "validate_json_schema": true,
      "sanitize_web_inputs": true,
      "validate_ip_addresses": true,
      "require_valid_ipv4": true
    },
    "web_security": {
      "enabled": true,
      "require_authentication": {% if environment == "production" %}true{% else %}false{% endif %},
      "_comment_auth": "🔧 Sin auth para desarrollo - añadir en producción",
      "rate_limiting": true,
      "request_logging": {{ dashboard.log_web_requests | default(true) }},
      "error_masking": {% if environment == "production" %}true{% else %}false{% endif %},
      "xss_protection": true,
      "content_type_validation": true
    },
    "fleet_security": {
      "enabled": true,
      "validate_agent_responses": true,
      "command_confirmation": {% if environment == "production" %}true{% else %}false{% endif %},
      "_comment_confirmation": "🔧 Dashboard puede ejecutar sin confirmación en desarrollo",
      "max_commands_per_minute": {{ security.max_commands_per_minute | default(60) }},
      "max_concurrent_commands": {{ security.max_concurrent_commands | default(10) }}
    },
    "_comment_etcd_security": "🔐 NUEVO: Seguridad específica ETCD",
    "etcd_crypto_security": {
      "validate_pipeline_keys": true,
      "rotate_keys_on_error": {% if environment == "production" %}true{% else %}false{% endif %},
      "secure_key_storage": true,
      "crypto_failure_threshold": {{ security.crypto_failure_threshold | default(10) }}
    },
    "privacy": {
      "anonymize_ips": {% if environment == "production" %}true{% else %}false{% endif %},
      "mask_sensitive_data": {% if environment == "production" %}true{% else %}false{% endif %}
    }
  },

  "distributed": {
    "cluster_name": "{{ cluster_name | default('upgraded-happiness-cluster') }}",
    "component_role": "dashboard_scada_monitoring_etcd",
    "enable_container_detection": true,
    "enable_system_info_collection": true,
    "pipeline_tracking": {
      "enabled": true,
      "track_latency": true,
      "track_component_path": true,
      "max_pipeline_hops": {{ distributed.max_pipeline_hops | default(6) }},
      "track_etcd_crypto_operations": true
    },
    "dashboard_specific": {
      "track_visualization_latency": {{ dashboard.track_viz_latency | default(true) }},
      "track_fleet_communication_latency": true,
      "track_web_performance": true,
      "enable_dashboard_analytics": {{ dashboard.enable_analytics | default(true) }},
      "track_crypto_performance": true,
      "register_firewall_rules_in_etcd": {{ dashboard.register_firewall_rules | default(true) }},
      "_comment_rules_registration": "🔥 NUEVO: Dashboard registra reglas firewall en ETCD"
    }
  },

  "data_visualization": {
    "enabled": {{ dashboard.visualization_enabled | default(true) }},
    "real_time_updates": {{ dashboard.real_time_updates | default(true) }},
    "update_interval_ms": {{ dashboard.update_interval | default(1000) }},
    "_comment_update": "🔧 1s updates para tiempo real",
    "max_data_points": {{ dashboard.max_data_points | default(1000) }},
    "data_retention": {
      "events_hours": {{ dashboard.events_retention_hours | default(4) }},
      "metrics_hours": {{ dashboard.metrics_retention_hours | default(8) }},
