  "debug": {
    "enabled": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_all_events": {% if environment == "local" %}true{% else %}false{% endif %},
    "log_web_requests": {% if environment == "local" %}true{% else %}false{% endif %},
    "simulate_events": {% if environment == "local" %}true{% else %}false{% endif %},
    "performance_profiling": {% if environment == "local" %}true{% else %}false{% endif %},
    "_comment_etcd_debug": "🔐 Debug específico ETCD (solo para desarrollo)",
    "log_etcd_operations": {% if environment == "local" %}true{% else %}false{% endif %},
    "trace_pipeline_key_operations": {% if environment == "local" %}true{% else %}false{% endif %},
    "validate_crypto_tokens": true,
    "log_fleet_crypto_details": {% if environment == "local" %}true{% else %}false{% endif %}
  },

  "_comment_crypto": "🔐 CRYPTO ETCD - OBLIGATORIO: ML events + Fleet commands/responses",
  "crypto": {
    "enabled": true,
    "role": "receiver_sender",
    "use_etcd_pipeline_key": true,
    "_comment_mandatory": "❌ Sin token ETCD = componente NO ARRANCA",
    "channels": {
      "ml_events_input": {
        "decrypt": true,
        "decompress": true,
        "_comment_decompress": "🔧 CRÍTICO: ETCD debe descomprimir ANTES de parsing protobuf",
        "description": "Descifrar y descomprimir eventos ML para visualización con ETCD pipeline key"
      },
      "fleet_commands_output": {
        "encrypt": true,
        "compress": true,
        "_comment_compress": "🔧 CRÍTICO: ETCD debe comprimir DESPUÉS de serializar protobuf",
        "_comment_pattern": "🔤 ACTUALIZADO: Ahora usa PUB en puerto 5583",
        "description": "Cifrar y comprimir comandos hacia fleet de agentes con ETCD pipeline key (PUB:5583)"
      },
      "fleet_responses_input": {
        "decrypt": true,
        "decompress": true,
        "_comment_decompress": "🔧 CRÍTICO: ETCD debe descomprimir ANTES de parsing protobuf",
        "_comment_pattern": "🔥 ACTUALIZADO: Ahora usa SUB en puerto 5584",
        "description": "Descifrar y descomprimir respuestas de fleet con ETCD pipeline key (SUB:5584)"
      },
      "scheduler_communication": {
        "encrypt": true,
        "decrypt": true,
        "compress": true,
        "description": "Comunicación opcional cifrada con scheduler (si habilitada) con ETCD pipeline key"
      }
    },
    "component_crypto_id": "{{ node_id | default('dashboard_main_v31_etcd_001') }}",
    "_comment_etcd": "Token rotativo distribuido automáticamente por ETCD - mucho más seguro que config files"
  },

  "_etcd_integration_requirements": {
    "mandatory_dependencies": [
      "ETCD cluster running on {{ etcd_service_name }}:{{ etcd_port }}",
      "ETCD Crypto Coordinator active",
      "ML Detector tricapa running on port {{ services.ml_detector.zmq_pub_port | default(5580) }} (PUB)",
      "Firewall Agents fleet on configured ports",
      "etcd3-py with compatible protobuf version"
