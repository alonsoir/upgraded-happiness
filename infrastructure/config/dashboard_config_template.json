      "network_topology": {{ dashboard.show_network_topology | default(true) }},
      "firewall_rules_status": {{ dashboard.show_firewall_status | default(true) }},
      "system_performance": {{ dashboard.show_system_performance | default(true) }}
    },
    "export": {
      "enabled": {{ dashboard.enable_export | default(true) }},
      "formats": [
        "JSON",
        "CSV"
      ],
      "max_export_size": {{ dashboard.max_export_size | default(10000) }}
    }
  },

  "api": {
    "enabled": {{ dashboard.api_enabled | default(true) }},
    "version": "v3.1",
    "base_path": "/api/v3.1",
    "endpoints": {
      "events": "/events",
      "metrics": "/metrics",
      "health": "/health",
      "fleet": "/fleet",
      "firewall": "/firewall",
      "config": "/config"
    },
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": {{ dashboard.api_rate_limit | default(1000) }},
      "burst": {{ dashboard.api_burst_limit | default(100) }}
    },
    "documentation": {
      "enabled": {% if environment == "local" %}true{% else %}false{% endif %},
      "swagger_ui": {% if environment == "local" %}true{% else %}false{% endif %},
      "endpoint": "/api/docs"
    }
