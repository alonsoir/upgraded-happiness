Vagrant.configure("2") do |config|
  # Ubuntu Server 24.04 LTS
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "lab-ubuntu"

  # Network configuration
  config.vm.network "forwarded_port", guest: 22, host: 2222, id: "ssh"
  config.vm.network "forwarded_port", guest: 80, host: 8080
  config.vm.network "forwarded_port", guest: 443, host: 8443
  config.vm.network "forwarded_port", guest: 2379, host: 12379  # etcd
  config.vm.network "forwarded_port", guest: 6443, host: 6443  # k3s

  # Enable promiscuous mode for packet capture
  config.vm.network "public_network", type: "dhcp"

  # VM configuration
  config.vm.provider "virtualbox" do |vb|
    vb.name = "upgraded-happiness-lab"
    vb.memory = "4096"
    vb.cpus = 2
    vb.gui = false

    # Enable promiscuous mode for packet capture
    vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
    vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
    vb.customize ["modifyvm", :id, "--nictype2", "virtio"]
  end

  # Sync project folder
  config.vm.synced_folder ".", "/home/vagrant/upgraded-happiness",
    owner: "vagrant", group: "vagrant", mount_options: ["dmode=755,fmode=644"]

  # Provision script
  config.vm.provision "shell", inline: <<-SHELL
    set -e

    echo "🔄 Updating system..."
    apt-get update
    apt-get upgrade -y

    echo "📦 Installing base packages..."
    apt-get install -y \
      curl \
      wget \
      git \
      htop \
      net-tools \
      tcpdump \
      ca-certificates \
      gnupg \
      lsb-release

    echo "🐳 Installing Docker..."
    # Official Docker installation
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

    # Add vagrant user to docker group
    usermod -aG docker vagrant

    echo "☸️ Installing k3s..."
    curl -sfL https://get.k3s.io | sh -s - --write-kubeconfig-mode 644

    echo "🔧 Installing docker-compose standalone..."
    curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
    chmod +x /usr/local/bin/docker-compose

    echo "🔧 Configuring packet capture permissions..."
    # Allow vagrant user to capture packets
    setcap cap_net_raw,cap_net_admin=eip /usr/bin/tcpdump

    echo "📁 Setting up project directory..."
    cd /home/vagrant/upgraded-happiness
    chown -R vagrant:vagrant /home/vagrant/upgraded-happiness

    # Create start script
    cat > /home/vagrant/start-lab.sh << 'EOF'
#!/bin/bash
set -e

cd /home/vagrant/upgraded-happiness

echo "🚀 Starting Upgraded Happiness Lab..."

# Verify Docker is running
if ! docker info >/dev/null 2>&1; then
    echo "Starting Docker..."
    sudo systemctl start docker
fi

# Build images if they don't exist
if [ ! "$(docker images -q upgraded-happiness/sniffer:v3.1-etcd 2> /dev/null)" ]; then
    echo "🔨 Building Docker images..."
    ./infrastructure/docker/build_all_images.sh
fi

# Start the pipeline
echo "🚀 Starting pipeline..."
docker compose -f infrastructure/docker/docker-compose.yml up -d

echo "✅ Lab started successfully!"
echo ""
echo "📋 Services status:"
docker compose -f infrastructure/docker/docker-compose.yml ps
echo ""
echo "🌐 Access points:"
echo "  Dashboard: http://localhost:8080"
echo "  k3s API: https://localhost:6443"
echo ""
echo "📊 To view logs: docker compose -f infrastructure/docker/docker-compose.yml logs -f"
EOF

    chmod +x /home/vagrant/start-lab.sh
    chown vagrant:vagrant /home/vagrant/start-lab.sh

    echo "✅ Provisioning completed!"
    echo ""
    echo "🎯 Next steps:"
    echo "  1. Run: vagrant ssh"
    echo "  2. Run: ./start-lab.sh"
    echo ""

  SHELL
end