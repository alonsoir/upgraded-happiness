        # Stats actualizadas para DUAL COMMUNICATION
        self.stats = {
            'scheduler_commands_received': 0,
            'dashboard_commands_received': 0,
            'commands_processed': 0,
            'scheduler_responses_sent': 0,
            'dashboard_responses_sent': 0,
            'errors': 0,
            'start_time': time.time(),
