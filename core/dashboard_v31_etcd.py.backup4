        .status-dot.connected { background: #00ff88; box-shadow: 0 0 10px #00ff88; }
        .status-dot.warning { background: #ffaa00; box-shadow: 0 0 10px #ffaa00; }
        .status-dot.disconnected { background: #ff4444; box-shadow: 0 0 10px #ff4444; }

        .main-content {
