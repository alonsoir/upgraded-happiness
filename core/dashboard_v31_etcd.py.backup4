            padding: 5px 10px;
            border-radius: 4px;
            font-family: inherit;
        }

        .map-container {
            grid-column: 1 / -1;
            height: 400px;
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid rgba(0, 255, 136, 0.3);
